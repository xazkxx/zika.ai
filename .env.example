APP_NAME=ERP Core
# 生产库（应用运行时用；**测试绝不读它**，见 tests/conftest.py）
DATABASE_URL=postgresql+psycopg://erp:密码@127.0.0.1:5432/erp
# 测试库（A5 测试库隔离，2026-10-27）。没配这一项 pytest 会直接拒绝运行。
# 用 `python scripts/test_db.py init` 建独立实例后会自动写进 .env。
TEST_DATABASE_URL=postgresql+psycopg://erp_test@127.0.0.1:55432/erp_test
SECRET_KEY=replace-this-with-a-secure-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
