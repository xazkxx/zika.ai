:root {
  font-family: 'Microsoft YaHei', 'PingFang SC', sans-serif;
  color: #1f2937;
  background: #f3f6fb;
  line-height: 1.5;
  font-weight: 400;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  height: 100%;
}

body {
  background: linear-gradient(135deg, #eef5ff 0%, #f7f9fc 100%);
}

/* ============ 登录页（科技感 B 端：蓝色螺旋背景 + 磨砂玻璃卡片）============
   配色比例：渐变 64% / 蓝紫层 28% / 唯一实心 1%（Logo 与主按钮）
   主色 #0F172A　强调色 #3B82F6　字体 Inter　标题 18px / 正文 14px */
.auth-shell {
  position: relative;
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 32px 20px;
  background: #0f172a;
  overflow: hidden;
  color: #f8fafc;
}
/* 蓝色螺旋光晕（渐变色 64%） */
.auth-shell::before {
  content: "";
  position: absolute;
  inset: -20%;
  background:
    radial-gradient(circle at 18% 22%, rgba(59, 130, 246, 0.32), transparent 42%),
    radial-gradient(circle at 82% 26%, rgba(129, 140, 248, 0.26), transparent 44%),
    radial-gradient(circle at 50% 92%, rgba(49, 46, 129, 0.42), transparent 55%),
    conic-gradient(from 200deg at 58% 42%, rgba(59, 130, 246, 0.2), rgba(129, 140, 248, 0.13), rgba(30, 27, 75, 0.06) 32%, transparent 46%, rgba(96, 165, 250, 0.2) 82%, rgba(59, 130, 246, 0.2));
  filter: blur(6px);
  animation: authDrift 26s ease-in-out infinite alternate;
}
@keyframes authDrift {
  from { transform: rotate(-3deg) scale(1.02); }
  to { transform: rotate(3deg) scale(1.08); }
}
/* 细网格纹理：强化科技感 */
.auth-shell::after {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(148, 163, 184, 0.05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(148, 163, 184, 0.05) 1px, transparent 1px);
  background-size: 46px 46px;
  -webkit-mask-image: radial-gradient(circle at 50% 42%, #000, transparent 78%);
  mask-image: radial-gradient(circle at 50% 42%, #000, transparent 78%);
}
.auth-stage {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  justify-content: center;
}
/* 磨砂玻璃卡片（蓝紫层 28%） */
.auth-card {
  width: min(440px, 100%);
  background: linear-gradient(160deg, rgba(30, 41, 82, 0.72), rgba(15, 23, 42, 0.66));
  backdrop-filter: blur(22px) saturate(140%);
  -webkit-backdrop-filter: blur(22px) saturate(140%);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 22px;
  padding: 40px 36px 32px;
  box-shadow: 0 30px 70px -20px rgba(2, 6, 23, 0.85), 0 0 0 1px rgba(255, 255, 255, 0.03) inset, 0 1px 0 rgba(255, 255, 255, 0.10) inset;
}
.auth-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 14px;
  margin-bottom: 30px;
}
.auth-logo {
  width: 56px;
  height: 56px;
  border-radius: 16px;
  display: grid;
  place-items: center;
  background: #3b82f6;
  box-shadow: 0 12px 30px -8px rgba(59, 130, 246, 0.75);
  position: relative;
}
.auth-logo::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 16px;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.28), transparent 55%);
}
.auth-logo svg { width: 30px; height: 30px; display: block; position: relative; z-index: 1; }
.auth-brand h1 { font-size: 18px; font-weight: 600; margin: 0; letter-spacing: 0.01em; }
.auth-tagline { font-size: 14px; color: #94a3b8; margin: 0; }
.auth-form { display: block; }
.auth-field { margin-bottom: 16px; }
.auth-field > label { display: block; font-size: 13px; color: #94a3b8; margin-bottom: 7px; }
.auth-control { position: relative; display: flex; align-items: center; }
.auth-lead-icon {
  position: absolute;
  left: 14px;
  width: 18px;
  height: 18px;
  color: #64748b;
  pointer-events: none;
  transition: color 0.16s ease;
}
.auth-control input {
  width: 100%;
  height: 48px;
  background: rgba(15, 23, 42, 0.55);
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 12px;
  color: #f8fafc;
  font-size: 14px;
  font-family: inherit;
  padding: 0 44px 0 42px;
  outline: none;
  transition: border-color 0.16s ease, background 0.16s ease, box-shadow 0.16s ease;
}
.auth-control input::placeholder { color: #64748b; }
.auth-control input:focus {
  border-color: rgba(59, 130, 246, 0.65);
  background: rgba(15, 23, 42, 0.75);
  box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.14);
}
.auth-control input:focus ~ .auth-lead-icon { color: #60a5fa; }
.auth-eye {
  position: absolute;
  right: 8px;
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  background: transparent;
  border: none;
  border-radius: 8px;
  color: #64748b;
  cursor: pointer;
  transition: color 0.16s ease, background 0.16s ease;
}
.auth-eye:hover { color: #f8fafc; background: rgba(148, 163, 184, 0.12); }
.auth-eye svg { width: 18px; height: 18px; }
.auth-row { display: flex; align-items: center; justify-content: space-between; margin: 4px 0 22px; }
.auth-remember {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: #94a3b8;
  cursor: pointer;
  user-select: none;
}
.auth-remember input {
  appearance: none;
  -webkit-appearance: none;
  width: 16px;
  height: 16px;
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 5px;
  background: rgba(15, 23, 42, 0.55);
  cursor: pointer;
  position: relative;
  transition: background 0.16s ease, border-color 0.16s ease;
}
.auth-remember input:checked { background: #3b82f6; border-color: #3b82f6; }
.auth-remember input:checked::after {
  content: "";
  position: absolute;
  left: 5px;
  top: 2px;
  width: 4px;
  height: 8px;
  border: solid #fff;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}
.auth-link { color: #60a5fa; font-size: 13px; text-decoration: none; cursor: pointer; transition: color 0.16s ease; }
.auth-link:hover { color: #bfdbfe; text-decoration: underline; }
.auth-submit {
  width: 100%;
  height: 48px;
  border: none;
  border-radius: 12px;
  background: #3b82f6;
  color: #fff;
  font-size: 15px;
  font-weight: 600;
  font-family: inherit;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  transition: transform 0.12s ease, box-shadow 0.16s ease, background 0.16s ease;
  box-shadow: 0 14px 30px -10px rgba(59, 130, 246, 0.85);
}
.auth-submit:hover:not(:disabled) { background: #2f74e8; transform: translateY(-1px); }
.auth-submit:active:not(:disabled) { transform: translateY(0); }
.auth-submit:disabled { background: #27354e; color: #64748b; box-shadow: none; cursor: not-allowed; }
.auth-spinner {
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: authSpin 0.7s linear infinite;
}
@keyframes authSpin { to { transform: rotate(360deg); } }
.auth-notice {
  margin-top: 14px;
  padding: 10px 12px;
  border-radius: 10px;
  background: rgba(59, 130, 246, 0.12);
  border: 1px solid rgba(59, 130, 246, 0.32);
  color: #bfdbfe;
  font-size: 13px;
}
.auth-divider { display: flex; align-items: center; gap: 14px; margin: 26px 0 18px; color: #64748b; font-size: 12px; }
.auth-divider::before,
.auth-divider::after { content: ""; flex: 1; height: 1px; background: rgba(148, 163, 184, 0.16); }
.auth-socials { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.auth-social {
  height: 46px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  background: rgba(15, 23, 42, 0.5);
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 12px;
  color: #f8fafc;
  font-size: 13px;
  font-family: inherit;
  cursor: pointer;
  transition: background 0.16s ease, border-color 0.16s ease;
}
.auth-social:hover { background: rgba(148, 163, 184, 0.12); border-color: rgba(255, 255, 255, 0.12); }
.auth-social svg { width: 18px; height: 18px; }
.auth-foot { margin-top: 26px; text-align: center; font-size: 13px; color: #94a3b8; }
.auth-privacy { margin-top: 16px; font-size: 12px; color: #64748b; line-height: 1.7; }
@media (max-width: 520px) {
  .auth-shell { padding: 20px 16px; }
  .auth-card { max-width: 100%; border-radius: 18px; padding: 30px 20px 24px; }
}
@media (max-width: 380px) {
  .auth-socials { grid-template-columns: 1fr; }
}

button,
input,
textarea,
select {
  font: inherit;
}

.app-shell {
  display: flex;
  min-height: 100vh;
}

/* ===== 手机端顶部工具栏 / 抽屉遮罩 / 抽屉关闭按钮：桌面端一律不显示 ===== */
.mobile-bar,
.sidebar-backdrop,
.sidebar-close {
  display: none;
}

.sidebar {
  width: 260px;
  flex-shrink: 0;
  background: #111827;
  color: white;
  padding: 22px 16px 18px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  /* 悬浮岛式侧边栏：四周留白 + 大圆角 + 柔和阴影，让侧边栏"浮"在主背景之上 */
  height: calc(100vh - 32px);
  position: sticky;
  top: 16px;
  margin: 16px 0 16px 16px;
  border-radius: 20px;
  box-shadow: 0 12px 40px rgba(15, 23, 42, 0.18);
  overflow-y: auto;
}

.brand {
  font-size: 1.5rem;
  font-weight: 700;
  margin-bottom: 24px;
}

/* 侧边栏专属品牌块，不影响登录页的 .brand */
.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 1.02rem;
  margin-bottom: 0;
  padding: 0 4px;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 11px;
  background: linear-gradient(135deg, #2563eb, #4f46e5);
  font-size: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  flex-shrink: 0;
}

.brand-text {
  color: #f1f5f9;
  letter-spacing: 0.02em;
}

.side-nav {
  display: flex;
  flex-direction: column;
  gap: 2px;
  flex: 1;
  min-height: 0;
  /* 2026-10-15 菜单字体统一：字体族 / 行高。写在 .side-nav 一处即可 ——
     styles.css 第 270 行的 `button { font: inherit }` 会让全部菜单按钮继承下去。 */
  font-family: system-ui, -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  line-height: 1.5;
}

.nav-group {
  display: flex;
  flex-direction: column;
}

.nav-group-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
  background: transparent;
  border: none;
  color: #7c8ba1;
  font-size: 14px;
  font-weight: 500;
  padding: 14px 10px 6px;
  cursor: pointer;
  border-radius: 8px;
  transition: color 0.15s ease;
}

.nav-group-title:hover {
  color: #cbd5e1;
}

.nav-group.has-active .nav-group-title {
  color: #93c5fd;
}

.nav-group-arrow {
  width: 6px;
  height: 6px;
  border-right: 1.5px solid currentColor;
  border-bottom: 1.5px solid currentColor;
  transform: rotate(45deg);
  transition: transform 0.18s ease;
  flex-shrink: 0;
  margin-right: 2px;
}

.nav-group-title.collapsed .nav-group-arrow {
  transform: rotate(-45deg);
}

.nav-group-items {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.nav-item {
  position: relative;
  background: transparent;
  border: none;
  color: #cbd5e1;
  text-align: left;
  padding: 10px 10px 10px 20px;
  border-radius: 9px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 400;
  transition: background 0.15s ease, color 0.15s ease;
}

.nav-item::before {
  content: '';
  position: absolute;
  left: 11px;
  top: 50%;
  width: 4px;
  height: 4px;
  margin-top: -2px;
  border-radius: 50%;
  background: #475569;
  transition: background 0.15s ease;
}

.nav-item:hover {
  background: rgba(255, 255, 255, 0.06);
  color: #f8fafc;
}

.nav-item.active {
  background: linear-gradient(90deg, rgba(37, 99, 235, 0.92), rgba(79, 70, 229, 0.72));
  color: #fff;
  font-weight: 500;
  box-shadow: 0 6px 16px -8px rgba(37, 99, 235, 0.95);
}

.nav-item.active::before {
  background: #fff;
}

.logout-btn {
  margin-top: auto;
  border: 1px solid rgba(148, 163, 184, 0.4);
  background: rgba(15, 23, 42, 0.18);
  color: white;
  border-radius: 10px;
  padding: 10px 12px;
  cursor: pointer;
}

.main-panel {
  flex: 1;
  padding: 36px 44px 44px;
  /* ⚠️ 必须有：flex 项默认 min-width:auto，不会缩到"内容最小宽度"以下。
     发票管理页的宽表格（9 列）就是靠这一条把整个主区撑到 1531px、
     文档出现横向滚动条的 —— 而 .table-wrap 的 overflow-x:auto 因为
     容器自己没被约束，根本没机会生效。
     这类问题只在"某个页面刚好比其它页面宽"时才会暴露。 */
  min-width: 0;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30px;
}

.topbar-actions {
  display: flex;
  gap: 12px;
  align-items: center;
}

/* 顶栏的主/次按钮必须**同高**。
   此前主按钮用 .primary-btn、次按钮用 .secondary-btn.small-btn，padding 一个
   12px 20px、一个 10px 16px，并排放着明显不齐。统一 padding 之后还差 2px ——
   因为 .secondary-btn 有 1px 边框而 .primary-btn 是 border: none，
   按钮没有显式高度时边框会把自动高度撑大。这里给主按钮补一条同宽的透明边框补齐。 */
.topbar-actions .primary-btn,
.topbar-actions .secondary-btn {
  padding: 10px 18px;
  font-size: 0.9rem;
  height: 40px; /* 2026-10-16 全局排版：顶栏按钮统一 40px（压过 .small-btn 的 height:auto） */
  white-space: nowrap;
}

.topbar-actions .primary-btn {
  border: 1px solid transparent;
}

.eyebrow {
  margin: 0 0 8px;
  color: #6b7280;      /* 2026-10-16 全局排版：辅助说明 13px / #6B7280 */
  font-size: 13px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

h1 {
  margin: 0;
  /* 2026-10-16 全局排版：页面主标题统一 24px/600。
     登录页标题不受影响（.auth-brand h1 在第 113 行，类选择器优先级更高） */
  font-size: 24px;
  font-weight: 600;
  color: #111827;
}

.primary-btn {
  /* 主按钮：纯蓝、40px 高、6px 圆角（2026-10-16 全局排版）。
     border 用透明 1px 而不是 none：和 .secondary-btn 的实体边框对齐，保证并排同高 */
  border: 1px solid transparent;
  background: #2563eb;
  color: white;
  height: 40px;
  padding: 8px 16px;
  border-radius: 6px;
  font-weight: 600;
  cursor: pointer;
}

.secondary-btn {
  border: 1px solid #cbd5e1;
  background: #fff;
  color: #0f172a;
  height: 40px;
  padding: 8px 16px;
  border-radius: 6px;
  font-weight: 600;
  cursor: pointer;
}

.small-btn {
  /* 行内 / 表格操作列的紧凑按钮：不强制 40px，否则会把 48~52px 的表格行撑爆。
     靠源码顺序压过上面两条的 height:40px（同为 0,1,0，后者生效） */
  padding: 10px 16px;
  height: auto;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px; /* 2026-10-16 全局排版：网格卡片间距统一 16px */
}

.stat-card,
.panel {
  background: #ffffff;
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 18px;
  box-shadow: 0 6px 24px rgba(15, 23, 42, 0.06), 0 1px 3px rgba(15, 23, 42, 0.05);
}

.stat-card {
  padding: 24px; /* 2026-10-16 全局排版：卡片内边距统一 24px */
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.stat-card span {
  color: #6b7280;
  font-size: 13px; /* 辅助说明统一 13px */
}

.stat-card strong {
  font-size: 2rem;
  color: #0f172a;
}

.panel {
  margin-top: 30px;
  padding: 24px; /* 2026-10-16 全局排版：卡片内边距统一 24px */
}

/* 卡片/区块标题统一 16px/600（.section-header h2 是首页与看板的小节标题，观感对齐） */
.panel h2,
.section-header h2 {
  margin-top: 0;
  font-size: 16px;
  font-weight: 600;
  color: #111827;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18px;
}

.status-badge {
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border-radius: 999px;
  background: rgba(34, 197, 94, 0.12);
  color: #15803d;
  font-size: 0.82rem;
  font-weight: 700;
}

.management-grid {
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 16px; /* 2026-10-16 全局排版：网格卡片间距统一 16px */
}

/* grid 子项默认 min-width:auto：表格内容（如报价单列表）会把列撑破，
   连带把整个页面挤宽、压窄左侧菜单。显式允许收缩，让表格在自身容器里横向滚动。 */
.management-grid > section {
  min-width: 0;
}

.erp-form {
  display: flex;
  flex-direction: column;
  gap: 20px; /* 2026-10-16 全局排版：表单项行间距 20px（销售订单等全部表单生效） */
}

.form-row {
  display: grid;
  gap: 16px;
}

.two-col {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

/* 订单页三列明细行：商品 / 数量 / 单价 */
.form-row.three-col {
  grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
  align-items: end;
}

/* 订单明细合计行 */
.order-items-summary {
  padding: 10px 12px;
  border-radius: 8px;
  background: #f1f5f9;
  color: #334155;
  font-weight: 600;
  font-size: 0.92rem;
}

/* 表格操作列：横向排列不换行挤压 */
.row-actions {
  white-space: nowrap;
}

.erp-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #374151;      /* 2026-10-16 全局排版：表单标签 14px/500 */
  font-weight: 500;
  font-size: 14px;
}

/* 表单里横向排列的复选框行（如仓库档案的「启用」） */
.erp-form label.checkbox-row {
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
}

.erp-form label.checkbox-row input {
  width: auto;
  margin: 0;
}

/* 2026-10-16 全局排版：输入框/下拉框统一 8px 12px 内边距、40px 高。
   ⚠️ 必须用 :not() 排除复选框/单选框，否则仓库档案的「启用」、权限勾选框
   会被撑成 40px 见方的大方块。textarea 不给固定高度（多行自伸缩）。 */
.erp-form input:not([type="checkbox"]):not([type="radio"]),
.erp-form textarea,
.erp-form select {
  width: 100%;
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  padding: 8px 12px;
  background: white;
  color: #0f172a;
}

.erp-form input:not([type="checkbox"]):not([type="radio"]),
.erp-form select {
  height: 40px;
}

.erp-form textarea {
  resize: vertical;
}

.report-grid {
  display: grid;
  gap: 16px; /* 2026-10-16 全局排版：网格卡片间距统一 16px */
}

.report-summary-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px; /* 2026-10-16 全局排版：网格卡片间距统一 16px */
}

.metric-card {
  display: flex;
  flex-direction: column;
  gap: 10px;
  background: rgba(248, 250, 252, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 14px;
  padding: 24px; /* 2026-10-16 全局排版：卡片内边距统一 24px */
}

.metric-card span {
  color: #6b7280;
  font-size: 13px; /* 辅助说明统一 13px */
}

.metric-card strong {
  font-size: 1.7rem;
  color: #0f172a;
}

/* 现存量看板：汇总卡片 + 状态标签 + 负数（欠货）标红 */
.stock-kpis {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
  gap: 16px; /* 2026-10-16 全局排版：网格卡片间距统一 16px */
  margin-bottom: 14px;
}

.stock-kpi {
  display: flex;
  flex-direction: column;
  gap: 4px;
  background: rgba(248, 250, 252, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 10px;
  padding: 10px 12px;
}

.stock-kpi-label {
  color: #64748b;
  font-size: 0.78rem;
}

.stock-kpi strong {
  font-size: 1.15rem;
  color: #0f172a;
}

.num-negative {
  color: #dc2626;
}

.stock-tag {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 0.75rem;
  background: #e2e8f0;
  color: #475569;
}

.stock-tag.low_stock {
  background: #fef3c7;
  color: #b45309;
}

.stock-tag.shortage {
  background: #fee2e2;
  color: #b91c1c;
}

.stock-tag.overstock {
  background: #dbeafe;
  color: #1d4ed8;
}

/* 表格里的操作按钮不换行（列窄时避免「编辑」「删除」被压成竖排） */
.data-table td button {
  white-space: nowrap;
}

/* 仓库档案：启用 / 停用状态标签 */
.stock-tag.tag-on {
  background: #dbeafe;
  color: #1d4ed8;
}

.stock-tag.tag-off {
  background: #f1f5f9;
  color: #94a3b8;
}

.chart-bars {
  display: grid;
  gap: 18px;
}

.chart-row {
  display: grid;
  grid-template-columns: 70px minmax(180px, 1fr) 120px;
  align-items: center;
  gap: 12px;
}

.chart-row span {
  color: #475569;
  font-weight: 600;
}

.chart-track {
  height: 14px;
  background: #e2e8f0;
  border-radius: 999px;
  overflow: hidden;
}

.chart-fill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #2563eb, #60a5fa);
}

.chart-row strong {
  color: #0f172a;
  font-size: 0.95rem;
  text-align: right;
}

.analysis-filter-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(180px, 1fr));
  gap: 16px;
  margin-bottom: 18px;
}

.analysis-filter-row label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #334155;
  font-weight: 600;
}

.analysis-filter-row input {
  width: 100%;
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  padding: 10px 12px;
  background: white;
  color: #0f172a;
}

.customer-rank-list {
  display: grid;
  gap: 12px;
  margin-top: 18px;
}

.rank-item {
  display: grid;
  grid-template-columns: 52px 1fr auto;
  align-items: center;
  gap: 12px;
  background: rgba(248, 250, 252, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 12px;
  padding: 12px 14px;
}

.rank-badge {
  display: inline-flex;
  justify-content: center;
  align-items: center;
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb, #60a5fa);
  color: white;
  font-weight: 700;
}

.rank-item strong {
  display: block;
}

.rank-item small {
  color: #64748b;
}

.upload-box {
  display: flex;
  flex-direction: column;
  gap: 12px;
  border: 1px dashed #94a3b8;
  border-radius: 14px;
  background: rgba(248, 250, 252, 0.9);
  padding: 18px;
  color: #334155;
  cursor: pointer;
  margin-top: 8px;
}

.upload-box input {
  width: 100%;
  padding: 10px 12px;
  border-radius: 10px;
  border: 1px solid #cbd5e1;
  background: white;
}

.agent-card {
  display: grid;
  gap: 18px;
}

.agent-card p {
  margin: 0;
  color: #334155;
  line-height: 1.8;
}

.agent-summary-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 18px;
}

.invoice-summary-row {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 18px;
  margin-top: 18px;
}

.invoice-action-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 18px;
}

.category-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 18px;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border-radius: 999px;
  background: rgba(37, 99, 235, 0.08);
  border: 1px solid rgba(37, 99, 235, 0.15);
  color: #1d4ed8;
  font-size: 0.85rem;
}

.invoice-list {
  display: grid;
  gap: 12px;
  margin-top: 18px;
}

.invoice-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.75);
}

.invoice-item strong {
  display: block;
  margin-bottom: 4px;
}

.invoice-item small {
  color: #64748b;
}

.invoice-amount {
  font-weight: 700;
  color: #0f172a;
}

.list {
  margin: 0;
  padding-left: 20px;
  color: #334155;
  line-height: 2;
}

.data-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
  /* 限定列宽：列多时不再被长内容横向撑爆，各列按表头平均分配、不随内容伸缩 */
  table-layout: fixed;
}

.data-table th,
.data-table td {
  /* 2026-10-16 全局排版：行高统一 48~52px。
     height 在 td 上等价于 min-height：纯文字行 = 48px；
     带操作按钮的行（.danger-btn 29.5px + 20px 上下内边距）≈ 50.5px。
     ⚠️ 不能用 14px 上下内边距 —— 会被行内按钮撑到 58.5px */
  height: 48px;
  padding: 10px 12px;
  border-bottom: 1px solid #e2e8f0;
  text-align: left;
  /* 一条记录一行：内容单行显示，超长用省略号，不再换行把行撑高 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 操作列 / 徽章列：按钮与状态标签要完整显示，不省略不换行 */
.data-table td:has(button),
.data-table th:has(button) {
  overflow: visible;
  white-space: nowrap;
  text-overflow: clip;
}

.data-table th {
  color: #6b7280;       /* 2026-10-16 全局排版：表头 13px / #6B7280 */
  font-size: 13px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  background: #f1f5f9;  /* 表头淡灰背景（比原来的白底加深一档） */
}

.empty-state,
.status-box,
.notice-box {
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16px;
  padding: 20px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  color: #0f172a;
}

.notice-box {
  margin-top: 18px;
  background: rgba(239, 246, 255, 0.9);
  border-color: rgba(96, 165, 250, 0.25);
  color: #1d4ed8;
  font-weight: 600;
}

.flow-list,
.recommendation-list {
  display: grid;
  gap: 16px;
}

.flow-card {
  background: rgba(248, 250, 252, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 14px;
  padding: 16px;
}

.flow-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}

.flow-steps {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
  gap: 10px;
}

.flow-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  min-height: 80px;
  padding: 12px 8px;
  border-radius: 12px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(255, 255, 255, 0.6);
  text-align: center;
}

.flow-step span {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #e2e8f0;
  color: #334155;
  font-weight: 700;
}

.flow-step.small,
.flow-step.pending {
  opacity: 0.7;
}

.flow-step.done {
  background: rgba(34, 197, 94, 0.12);
  border-color: rgba(34, 197, 94, 0.2);
}

.flow-step.active {
  background: rgba(59, 130, 246, 0.12);
  border-color: rgba(59, 130, 246, 0.2);
}

.flow-step.done span {
  background: #22c55e;
  color: white;
}

.flow-step.active span {
  background: #3b82f6;
  color: white;
}

.recommendation-item {
  width: 100%;
  text-align: left;
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(255, 255, 255, 0.75);
  border-radius: 12px;
  padding: 14px 16px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.recommendation-item.selected {
  border-color: rgba(59, 130, 246, 0.45);
  background: rgba(239, 246, 255, 0.95);
  box-shadow: 0 10px 22px rgba(59, 130, 246, 0.08);
}

.recommendation-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 8px;
}

.recommendation-item small {
  display: block;
  color: #475569;
  line-height: 1.6;
}

.priority-tag {
  display: inline-flex;
  align-items: center;
  padding: 4px 8px;
  border-radius: 999px;
  font-size: 0.74rem;
  font-weight: 700;
  text-transform: uppercase;
}

.priority-tag.high {
  background: rgba(239, 68, 68, 0.12);
  color: #b91c1c;
}

.priority-tag.medium {
  background: rgba(245, 158, 11, 0.12);
  color: #b45309;
}

.priority-tag.low {
  background: rgba(16, 185, 129, 0.12);
  color: #047857;
}

.selected-recommendation-box {
  margin-top: 12px;
  padding: 12px 14px;
  border-radius: 12px;
  background: rgba(239, 246, 255, 0.8);
  border: 1px solid rgba(59, 130, 246, 0.2);
  color: #1d4ed8;
  font-weight: 600;
}

.operations-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
}

.mini-panel {
  background: rgba(248, 250, 252, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 14px;
  padding: 16px;
}

.mini-panel h3 {
  margin: 0 0 14px;
  font-size: 1rem;
}

.mini-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 10px;
}

.mini-list li {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.18);
  padding: 10px 12px;
  border-radius: 10px;
}

.mini-list strong,
.mini-list small {
  display: block;
}

.mini-list small {
  color: #64748b;
  margin-top: 4px;
}

.mini-list span {
  font-size: 0.72rem;
  font-weight: 700;
  padding: 4px 8px;
  border-radius: 999px;
  background: rgba(59, 130, 246, 0.1);
  color: #1d4ed8;
}

.report-pill-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.report-pill {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 12px 10px;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.2);
  text-align: center;
}

.report-pill span {
  color: #64748b;
  font-size: 0.75rem;
}

.report-pill strong {
  color: #0f172a;
  font-size: 1.1rem;
}

.status-box.error {
  color: #b91c1c;
  background: rgba(254, 242, 242, 0.95);
  border-color: rgba(239, 68, 68, 0.2);
}

.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  display: grid;
  place-items: center;
  padding: 20px;
  z-index: 1000;
}

.modal-card {
  width: min(440px, 100%);
  background: white;
  border-radius: 18px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  box-shadow: 0 20px 40px rgba(15, 23, 42, 0.18);
  padding: 20px;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 18px;
}

.modal-header h3 {
  margin: 0;
  font-size: 1.25rem;
}

.modal-body {
  display: grid;
  gap: 10px;
  margin-bottom: 18px;
  color: #334155;
}

.modal-body p {
  margin: 0;
  line-height: 1.8;
}

.modal-actions {
  display: flex;
  justify-content: flex-end;
}

.mobile-app-shell {
  display: grid;
  gap: 18px;
  padding-bottom: 80px;
}

.mobile-hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 18px 20px;
  border-radius: 18px;
  background: linear-gradient(135deg, #111827, #1d4ed8);
  color: white;
  box-shadow: 0 16px 30px rgba(29, 78, 216, 0.18);
}

.mobile-hero h2 {
  margin: 0;
  color: white;
  font-size: 1.7rem;
}

.mobile-summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.mobile-stat-card {
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 16px;
  padding: 16px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-height: 110px;
}

.mobile-stat-card span {
  color: #64748b;
  font-size: 0.8rem;
}

.mobile-stat-card strong {
  font-size: 1.4rem;
  color: #0f172a;
}

.mobile-quick-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.mobile-action-btn {
  appearance: none;
  border: none;
  border-radius: 16px;
  padding: 16px 12px;
  font-weight: 700;
  font-size: 1rem;
  color: white;
  cursor: pointer;
  box-shadow: 0 12px 24px rgba(15, 23, 42, 0.08);
}

.mobile-action-btn.blue {
  background: linear-gradient(135deg, #2563eb, #60a5fa);
}

.mobile-action-btn.green {
  background: linear-gradient(135deg, #059669, #34d399);
}

.mobile-action-btn.orange {
  background: linear-gradient(135deg, #f59e0b, #fbbf24);
}

.mobile-action-btn.purple {
  background: linear-gradient(135deg, #7c3aed, #a78bfa);
}

.mobile-panel {
  margin-top: 0;
}

.mobile-bottom-dock {
  position: sticky;
  bottom: 0;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8px;
  padding: 12px 8px 10px;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  border-radius: 18px 18px 0 0;
  border-top: 1px solid rgba(148, 163, 184, 0.2);
  box-shadow: 0 -8px 20px rgba(15, 23, 42, 0.05);
}

.bom-shell {
  display: grid;
  gap: 20px;
}

.bom-form {
  display: grid;
  gap: 16px;
}

.bom-tree-root {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 12px;
}

.bom-node-item {
  list-style: none;
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: rgba(248, 250, 252, 0.9);
  border-radius: 12px;
  padding: 8px 10px;
}

.bom-node-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  min-height: 44px;
}

.bom-node-label {
  font-weight: 700;
  color: #0f172a;
}

.bom-node-meta {
  color: #475569;
  font-size: 0.78rem;
  background: rgba(37, 99, 235, 0.08);
  border: 1px solid rgba(37, 99, 235, 0.1);
  border-radius: 999px;
  padding: 4px 8px;
}

.bom-node-children {
  list-style: none;
  margin: 10px 0 0;
  padding-left: 12px;
  display: grid;
  gap: 8px;
}

.dock-btn {
  appearance: none;
  border: none;
  background: rgba(148, 163, 184, 0.08);
  border-radius: 12px;
  padding: 10px 8px;
  color: #475569;
  font-weight: 700;
  cursor: pointer;
}

.dock-btn.active {
  background: rgba(37, 99, 235, 0.12);
  color: #1d4ed8;
}

@media (max-width: 760px) {
  /* 手机端：侧边栏由「铺满首屏的两栏菜单」改成左侧抽屉，
     顶部只留一条工具栏，内容页直接可见，不用先划过 50 个菜单项。 */
  .app-shell {
    flex-direction: column;
  }

  .mobile-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    position: sticky;
    top: 0;
    z-index: 60;
    width: 100%;
    padding: 10px 14px;
    background: #111827;
    color: #f8fafc;
    box-shadow: 0 8px 20px -14px rgba(15, 23, 42, 0.95);
  }

  .mobile-menu-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(148, 163, 184, 0.4);
    background: rgba(15, 23, 42, 0.35);
    color: #f8fafc;
    border-radius: 9px;
    padding: 8px 12px;
    font-size: 0.9rem;
    cursor: pointer;
    flex-shrink: 0;
  }

  .mobile-menu-icon {
    position: relative;
    display: block;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  .mobile-menu-icon::before,
  .mobile-menu-icon::after {
    content: '';
    position: absolute;
    left: 0;
    display: block;
    width: 16px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  .mobile-menu-icon::before {
    top: -5px;
  }

  .mobile-menu-icon::after {
    top: 5px;
  }

  .mobile-bar-title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sidebar {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 80;
    width: 84vw;
    max-width: 320px;
    height: 100vh;
    padding: 18px 14px 16px;
    gap: 12px;
    margin: 0;
    border-radius: 0 16px 16px 0;
    transform: translateX(-102%);
    transition: transform 0.25s ease;
    box-shadow: 0 24px 60px -20px rgba(2, 6, 23, 0.85);
  }

  .app-shell.menu-open .sidebar {
    transform: translateX(0);
  }

  .sidebar-backdrop {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgba(15, 23, 42, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease;
  }

  .app-shell.menu-open .sidebar-backdrop {
    opacity: 1;
    pointer-events: auto;
  }

  .sidebar-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-left: auto;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    border: 1px solid rgba(148, 163, 184, 0.35);
    background: transparent;
    color: #cbd5e1;
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    flex-shrink: 0;
  }

  .side-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    align-items: stretch;
  }

  .nav-group {
    background: transparent;
    border-radius: 0;
    padding: 0;
  }

  .nav-group-title {
    font-size: 14px;
    padding: 12px 8px 6px;
  }

  .nav-item {
    font-size: 14px;
    padding: 10px 10px 10px 20px;
  }

  .nav-item::before {
    left: 9px;
  }

  .main-panel {
    padding: 16px 12px 28px;
  }

  .topbar {
    align-items: flex-start;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 18px;
  }

  .section-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .stats-grid,
  .report-summary-grid,
  .management-grid,
  .two-col,
  .analysis-filter-row,
  .report-pill-row {
    grid-template-columns: 1fr;
  }

  .panel {
    padding: 16px 14px;
    margin-top: 18px;
  }

  .mobile-summary-grid,
  .mobile-quick-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .chart-row {
    grid-template-columns: 56px 1fr 100px;
    gap: 8px;
  }

  .invoice-item {
    flex-direction: column;
    align-items: flex-start;
  }
}

/* ===== 发票详情弹窗 / 美观导出 ===== */

.invoice-item-right {
  display: flex;
  align-items: center;
  gap: 12px;
}

.link-btn {
  background: none;
  border: none;
  color: #2563eb;
  font-size: 13px;
  cursor: pointer;
  padding: 4px 6px;
  border-radius: 6px;
}

.link-btn:hover {
  background: #eff6ff;
  text-decoration: underline;
}

.danger-btn {
  background: #dc2626;
  border: none;
  color: #fff;
  font-size: 13px;
  cursor: pointer;
  padding: 5px 10px;
  border-radius: 6px;
}

.danger-btn:hover {
  background: #b91c1c;
}

.confirm-text {
  margin: 12px 0 6px;
  font-size: 14px;
  line-height: 1.6;
}

.confirm-hint {
  margin: 0 0 10px;
  font-size: 12px;
  color: #b45309;
  background: #fef3c7;
  border-radius: 6px;
  padding: 6px 10px;
}

/* 档案被业务数据引用、需要二次确认强制删除时的提示块 */
.confirm-blocked {
  margin-top: 10px;
  padding-top: 6px;
  border-top: 1px dashed #f0d9a8;
}

.select-col {
  width: 36px;
  text-align: center;
}

.select-col input,
td input[type="checkbox"] {
  width: 15px;
  height: 15px;
  cursor: pointer;
  accent-color: #6366f1;
}

.batch-delete-bar {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
  padding: 8px 12px;
  background: #fef2f2;
  border: 1px solid #fecaca;
  border-radius: 8px;
  font-size: 13px;
  color: #b91c1c;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 20px;
}

.modal-card {
  background: #ffffff;
  border-radius: 14px;
  width: 100%;
  max-width: 640px;
  max-height: 84vh;
  overflow-y: auto;
  box-shadow: 0 20px 50px rgba(15, 23, 42, 0.3);
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 22px;
  border-bottom: 1px solid #e2e8f0;
  position: sticky;
  top: 0;
  background: #ffffff;
  border-radius: 14px 14px 0 0;
}

.modal-header h3 {
  font-size: 17px;
  color: #1e293b;
  margin: 0;
}

.close-btn {
  background: none;
  border: none;
  font-size: 24px;
  line-height: 1;
  color: #64748b;
  cursor: pointer;
  padding: 2px 8px;
  border-radius: 8px;
}

.close-btn:hover {
  background: #f1f5f9;
  color: #0f172a;
}

.invoice-detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  padding: 20px 22px;
}

.detail-field {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.detail-field span {
  font-size: 12px;
  color: #64748b;
}

.detail-field strong {
  font-size: 14px;
  color: #1e293b;
  word-break: break-all;
}

.detail-field small {
  font-size: 12px;
  color: #94a3b8;
  word-break: break-all;
}

.detail-table {
  width: calc(100% - 44px);
  margin: 0 22px 20px;
  border-collapse: collapse;
  font-size: 13px;
}

.detail-table th {
  background: #f1f5f9;
  color: #475569;
  text-align: left;
  padding: 10px 12px;
  border-bottom: 2px solid #e2e8f0;
}

.detail-table td {
  padding: 10px 12px;
  border-bottom: 1px solid #e2e8f0;
  color: #1e293b;
}

.raw-text-box {
  margin: 0 22px 20px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #f8fafc;
}

.raw-text-box summary {
  padding: 10px 14px;
  font-size: 13px;
  color: #475569;
  cursor: pointer;
}

.raw-text-box pre {
  margin: 0;
  padding: 12px 14px;
  border-top: 1px solid #e2e8f0;
  font-size: 12px;
  white-space: pre-wrap;
  word-break: break-all;
  color: #334155;
  max-height: 220px;
  overflow-y: auto;
}

@media (max-width: 640px) {
  .invoice-detail-grid {
    grid-template-columns: 1fr;
  }
}

/* ===== 发票汇总页（参考发票登记明细表） ===== */

.invoice-chart-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 14px;
}

.chart-card {
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  padding: 14px;
  background: #f8fafc;
  min-width: 0;
}

.chart-card-title {
  font-size: 13px;
  font-weight: 600;
  color: #475569;
  margin-bottom: 10px;
}

.donut-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
}

.donut {
  width: 84px;
  height: 84px;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.donut-hole {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: #ffffff;
}

.donut-legend {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 12px;
  color: #334155;
  min-width: 0;
}

.legend-dot {
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 3px;
  margin-right: 6px;
  vertical-align: middle;
}

.deduct-legend {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.deduct-line {
  font-size: 13px;
  color: #334155;
}

.red-text {
  color: #dc2626 !important;
}

.mini-bars {
  display: flex;
  align-items: flex-end;
  gap: 4px;
  height: 110px;
  padding-top: 8px;
  border-bottom: 1px solid #e2e8f0;
}

.mini-bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  height: 100%;
  gap: 4px;
  min-width: 0;
}

.mini-bar-fill {
  width: 70%;
  border-radius: 3px 3px 0 0;
}

.bar-green {
  background: linear-gradient(180deg, #4ade80, #22c55e);
}

.bar-indigo {
  background: linear-gradient(180deg, #818cf8, #6366f1);
}

.mini-bar-col span {
  font-size: 10px;
  color: #64748b;
  white-space: nowrap;
}

.agent-report-box {
  border: 1px solid #c7d2fe;
  background: #eef2ff;
  border-radius: 10px;
  padding: 14px 16px;
  margin-bottom: 14px;
}

.agent-report-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.agent-report-header strong {
  color: #3730a3;
  font-size: 14px;
}

.agent-report-box pre {
  margin: 0;
  font-family: inherit;
  font-size: 13px;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-word;
  color: #1e293b;
}

.invoice-table-wrap {
  overflow-x: auto;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
}

/* 报价单列表：列比较多，窗口窄时横向滚动，而不是把操作按钮挤成竖排 */
.quotation-table-wrap {
  overflow-x: auto;
}

.quotation-table th,
.quotation-table td {
  white-space: nowrap;
}

/* 操作列固定在右侧：列多时横向滚动也能随时点「打印 / 转订单 / 删除」 */
.quotation-table th:last-child,
.quotation-table td:last-child {
  position: sticky;
  right: 0;
  background: #ffffff;
  box-shadow: -8px 0 10px -8px rgba(15, 23, 42, 0.15);
}

.invoice-summary-table {
  width: 100%;
  min-width: 900px;
  border-collapse: collapse;
  font-size: 12px;
}

.invoice-summary-table th {
  background: #f1f5f9;
  color: #475569;
  text-align: left;
  padding: 9px 10px;
  border-bottom: 2px solid #e2e8f0;
  white-space: nowrap;
}

.invoice-summary-table td {
  padding: 8px 10px;
  border-bottom: 1px solid #e2e8f0;
  color: #1e293b;
  white-space: nowrap;
}

.invoice-summary-table tbody tr:nth-child(even) {
  background: #f8fafc;
}

.invoice-month-row td {
  background: #eff6ff;
  font-weight: 600;
  color: #1e40af;
  border-bottom: 1px solid #bfdbfe;
}

.invoice-red-row td {
  color: #dc2626 !important;
  background: #fef2f2 !important;
}

.invoice-summary-table tfoot td {
  font-weight: 700;
  background: #eff6ff;
  border-top: 2px solid #bfdbfe;
  border-bottom: none;
}

.deduct-check {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 12px;
  cursor: pointer;
  color: inherit;
}

.deduct-check input {
  cursor: pointer;
  accent-color: #16a34a;
}

.table-hint {
  margin-top: 8px;
  font-size: 12px;
  color: #64748b;
  text-align: right;
}

@media (max-width: 900px) {
  .invoice-chart-grid {
    grid-template-columns: 1fr;
  }
}

/* ── 数据导入导出（Excel）──────────────────────────────── */
.io-hint {
  margin: 0 0 14px;
  font-size: 13px;
  color: #475569;
  line-height: 1.7;
  background: #f1f5f9;
  border-left: 3px solid #2563eb;
  border-radius: 6px;
  padding: 10px 12px;
}

.io-hint strong {
  color: #1d4ed8;
}

.io-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 16px; /* 2026-10-16 全局排版：网格卡片间距统一 16px */
}

.io-card {
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  padding: 24px;  /* 2026-10-16 全局排版：卡片内边距统一 24px */
  background: #fff;
  display: flex;
  flex-direction: column;
  gap: 12px;      /* 图片/标题/说明/按钮之间的垂直间距从 8px 放宽到 12px */
  transition: box-shadow 0.15s ease, border-color 0.15s ease;
}

.io-card:hover {
  border-color: #bfdbfe;
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.08);
}

.io-card-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 8px;
}

.io-card-head h3 {
  margin: 0;
  font-size: 16px;      /* 2026-10-16 全局排版：卡片标题统一 16px/600 */
  font-weight: 600;
  color: #111827;
}

.io-keys {
  font-size: 11px;
  color: #1d4ed8;
  background: #eff6ff;
  border-radius: 999px;
  padding: 2px 8px;
  white-space: nowrap;
}

.io-card-meta {
  display: flex;
  flex-direction: column;
  gap: 2px;
  font-size: 12px;
  color: #64748b;
}

.io-required {
  color: #b45309;
}

.io-card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 16px; /* 2026-10-16 全局排版：按钮组与上方说明拉开 16px */
}

.io-file-btn {
  display: inline-flex;
  align-items: center;
  cursor: pointer;
  user-select: none;
}

.io-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 10px 0 14px;
}

.io-stat {
  font-size: 13px;
  font-weight: 600;
  border-radius: 8px;
  padding: 6px 12px;
}

.io-stat.ok {
  color: #15803d;
  background: #dcfce7;
}

.io-stat.warn {
  color: #b45309;
  background: #fef3c7;
}

.io-stat.bad {
  color: #b91c1c;
  background: #fee2e2;
}

.io-stat.muted {
  color: #475569;
  background: #f1f5f9;
}

.io-errors h4 {
  margin: 0 0 8px;
  font-size: 13px;
  color: #b91c1c;
}

.io-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 14px;
}

@media (max-width: 600px) {
  .io-grid {
    grid-template-columns: 1fr;
  }

  .io-card-actions button,
  .io-file-btn {
    flex: 1 1 auto;
    justify-content: center;
  }
}

/* ── 购销合同页（模板 A2）──────────────────────────────────────────── */
.contract-items {
  border: 1px dashed #cbd5e1;
  border-radius: 10px;
  padding: 10px 12px;
  margin: 6px 0 12px;
  background: #f8fafc;
}

.compact-header {
  margin-bottom: 6px;
}

.compact-header h3 {
  margin: 0;
  font-size: 0.95rem;
  color: #334155;
}

.contract-item-row {
  display: grid;
  grid-template-columns: minmax(0, 2fr) 90px 110px 66px;
  gap: 8px;
  align-items: center;
  margin-bottom: 8px;
}

.contract-item-row select,
.contract-item-row input {
  width: 100%;
  padding: 6px 8px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  font-size: 0.85rem;
  background: white;
}

.contract-item-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 2px;
}

.contract-search {
  display: flex;
  gap: 8px;
  margin-bottom: 12px;
}

.contract-search input {
  flex: 1;
  padding: 7px 10px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  font-size: 0.85rem;
}

.contract-detail {
  display: grid;
  gap: 6px;
  font-size: 0.85rem;
  max-height: 58vh;
  overflow: auto;
}

.contract-detail p {
  margin: 0;
  color: #334155;
}

.contract-detail table {
  margin-top: 6px;
}

.contract-own-block {
  border: 1px solid #dbeafe;
  border-radius: 10px;
  padding: 10px 12px;
  margin-bottom: 12px;
  background: #f0f7ff;
}

/* ── 菜单框架：浩技云框架位「待建」标记 ───────────────────────── */
.nav-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.nav-item.is-todo {
  opacity: 0.8;
}

.nav-todo {
  flex: none;
  font-size: 10px;
  line-height: 1;
  padding: 2px 5px;
  border-radius: 5px;
  background: rgba(250, 237, 218, 0.14);
  color: #d9a55a;
  border: 0.5px solid rgba(217, 165, 90, 0.38);
}

.nav-item.is-todo.active .nav-todo {
  background: rgba(250, 237, 218, 0.22);
  color: #f0c07a;
}

/* ── 「模块建设中」占位页 ─────────────────────────────────────── */
.todo-panel {
  max-width: 640px;
  margin: 40px auto;
  padding: 26px 30px;
  border: 1px dashed #cbd5e1;
  border-radius: 14px;
  background: #f8fafc;
}

.todo-badge {
  display: inline-block;
  font-size: 11px;
  padding: 3px 9px;
  border-radius: 6px;
  background: #faeeda;
  color: #633806;
  border: 0.5px solid #ef9f27;
  margin-bottom: 12px;
}

.todo-panel h2 {
  margin: 0 0 6px;
  font-size: 1.05rem;
  color: #334155;
}

.todo-sub {
  margin: 0 0 14px;
  font-size: 0.8rem;
  color: #64748b;
}

.todo-desc {
  margin: 0 0 16px;
  font-size: 0.86rem;
  line-height: 1.75;
  color: #475569;
}

.todo-tip {
  font-size: 0.8rem;
  line-height: 1.7;
  color: #0c447c;
  background: #e6f1fb;
  border: 0.5px solid #b5d4f4;
  border-radius: 8px;
  padding: 9px 12px;
}

.settings-hint {
  margin: 0 0 16px;
  font-size: 0.83rem;
  line-height: 1.75;
  color: #64748b;
}

/* ============ 工作台首页（运营概览）仪表盘 ============ */

/* 顶部问候横幅 */
.welcome-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
  padding: 26px 30px;
  border-radius: 18px;
  background: linear-gradient(120deg, #1d4ed8 0%, #0d9488 60%, #059669 100%);
  color: #fff;
  box-shadow: 0 14px 34px -12px rgba(13, 148, 136, 0.5);
  margin-bottom: 22px;
}

.welcome-date {
  margin: 0 0 6px;
  font-size: 0.82rem;
  opacity: 0.85;
  letter-spacing: 0.04em;
}

.welcome-title {
  margin: 0 0 8px;
  font-size: 1.7rem;
  font-weight: 700;
}

.welcome-sub {
  margin: 0;
  font-size: 0.92rem;
  opacity: 0.9;
}

.welcome-actions {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}

.welcome-btn {
  border: none;
  border-radius: 10px;
  padding: 11px 18px;
  font-weight: 600;
  font-size: 0.9rem;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.welcome-btn:hover {
  transform: translateY(-2px);
}

.welcome-btn.ghost {
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.35);
}

.welcome-btn.ghost:hover {
  background: rgba(255, 255, 255, 0.26);
}

.welcome-btn.solid {
  background: #fff;
  color: #0d9488;
  box-shadow: 0 8px 20px -6px rgba(0, 0, 0, 0.3);
}

/* KPI 卡片组 */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
  margin-bottom: 22px;
}

.kpi-card {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 20px;
  border-radius: 16px;
  background: #fff;
  border: 1px solid rgba(148, 163, 184, 0.22);
  box-shadow: 0 6px 18px rgba(15, 23, 42, 0.04);
  transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
  width: 100%;
  text-align: left;
  font: inherit;
  color: inherit;
  cursor: pointer;
}

.kpi-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 14px 28px rgba(15, 23, 42, 0.09);
  border-color: rgba(59, 130, 246, 0.4);
}

.kpi-card:focus-visible {
  outline: none;
  border-color: rgba(59, 130, 246, 0.6);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.28);
}

.kpi-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 60px;
  height: 60px;
  border-radius: 16px;
  font-size: 1.9rem;
  flex-shrink: 0;
}

.kpi-meta {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.kpi-label {
  color: #64748b;
  font-size: 0.82rem;
  font-weight: 600;
}

.kpi-value {
  font-size: 1.55rem;
  color: #0f172a;
  line-height: 1.2;
  letter-spacing: -0.01em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.kpi-sub {
  color: #94a3b8;
  font-size: 0.74rem;
}

.kpi-blue .kpi-icon { background: #dbeafe; }
.kpi-indigo .kpi-icon { background: #e0e7ff; }
.kpi-teal .kpi-icon { background: #ccfbf1; }
.kpi-green .kpi-icon { background: #d1fae5; }
.kpi-amber .kpi-icon { background: #fef3c7; }
.kpi-rose .kpi-icon { background: #ffe4e6; }
/* 蓝绿主题新增色：把首页 KPI 的杂色统一成蓝绿系 */
.kpi-cyan .kpi-icon { background: #cffafe; }
.kpi-sky .kpi-icon { background: #e0f2fe; }
.kpi-emerald .kpi-icon { background: #a7f3d0; }

/* 常用报表快捷入口（首页运营展板） */
.quick-report-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 12px;
}
.quick-report-card {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 14px;
  border-radius: 12px;
  border: 1px solid rgba(148, 163, 184, 0.22);
  background: #fff;
  cursor: pointer;
  transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
}
.quick-report-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 20px rgba(15, 23, 42, 0.08);
  border-color: #0d9488;
}
.qr-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
  flex-shrink: 0;
}
.qr-label {
  font-size: 0.85rem;
  font-weight: 600;
  color: #334155;
  text-align: left;
}
.qr-blue .qr-icon { background: #dbeafe; }
.qr-cyan .qr-icon { background: #cffafe; }
.qr-teal .qr-icon { background: #ccfbf1; }
.qr-green .qr-icon { background: #d1fae5; }
.qr-sky .qr-icon { background: #e0f2fe; }
.qr-emerald .qr-icon { background: #a7f3d0; }

/* 仪表盘两栏布局 */
.dash-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 22px;
  align-items: start;
}

.dash-panel {
  margin-top: 0;
}

/* 经营趋势 SVG 折线图 */
.trend-chart {
  position: relative;
  width: 100%;
}

.trend-svg {
  width: 100%;
  height: 180px;
  display: block;
}

.trend-labels {
  display: flex;
  justify-content: space-between;
  margin-top: 8px;
  color: #94a3b8;
  font-size: 0.76rem;
}

.trend-legend {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 10px;
  color: #64748b;
  font-size: 0.82rem;
}

.legend-dot {
  display: inline-block;
  width: 10px;
  height: 10px;
  border-radius: 3px;
  margin-left: 12px;
}

.legend-dot:first-child { margin-left: 0; }
.legend-dot.income { background: #2563eb; }
.legend-dot.expense { background: #f59e0b; }

/* 经营健康度 */
.health-list {
  display: grid;
  gap: 18px;
}

.health-row {
  display: grid;
  gap: 8px;
}

.health-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #475569;
  font-size: 0.88rem;
  font-weight: 600;
}

.health-head strong {
  font-size: 0.9rem;
  color: #0f172a;
}

.health-head .health-warn {
  color: #b45309;
}

.health-track {
  height: 10px;
  background: #eef2f7;
  border-radius: 999px;
  overflow: hidden;
}

.health-fill {
  height: 100%;
  border-radius: 999px;
  transition: width 0.4s ease;
}

.fill-good {
  background: linear-gradient(90deg, #10b981, #34d399);
}

.fill-warn {
  background: linear-gradient(90deg, #f59e0b, #fbbf24);
}

.health-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
  margin-top: 22px;
  padding-top: 18px;
  border-top: 1px solid #eef2f7;
}

.health-metric {
  display: flex;
  flex-direction: column;
  gap: 4px;
  text-align: center;
}

.health-metric-label {
  color: #94a3b8;
  font-size: 0.76rem;
}

.health-metric strong {
  font-size: 1.3rem;
  color: #0f172a;
}

/* 经营提醒卡片 */
.alert-list {
  display: grid;
  gap: 12px;
}

.alert-card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 16px;
  border-radius: 13px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  background: #f8fafc;
}

.alert-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  margin-top: 6px;
  flex-shrink: 0;
  background: #94a3b8;
}

.alert-warning .alert-dot { background: #f59e0b; }
.alert-warning { background: #fffbeb; border-color: rgba(245, 158, 11, 0.28); }
.alert-info .alert-dot { background: #3b82f6; }
.alert-info { background: #eff6ff; border-color: rgba(59, 130, 246, 0.22); }

.alert-body strong {
  display: block;
  color: #0f172a;
  font-size: 0.92rem;
}

.alert-body p {
  margin: 3px 0 0;
  color: #64748b;
  font-size: 0.84rem;
  line-height: 1.6;
}

/* 管理建议 */
.advice-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  gap: 12px;
}

.advice-list li {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  color: #334155;
  font-size: 0.9rem;
  line-height: 1.6;
}

.advice-num {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #e0e7ff;
  color: #4f46e5;
  font-size: 0.78rem;
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 1px;
}

/* 关键动态时间线 */
.activity-timeline {
  display: grid;
  gap: 0;
}

.timeline-item {
  display: flex;
  gap: 14px;
  padding: 12px 0;
  position: relative;
}

.timeline-item:not(:last-child)::after {
  content: '';
  position: absolute;
  left: 21px;
  top: 42px;
  bottom: -6px;
  width: 2px;
  background: #e2e8f0;
}

.timeline-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  border-radius: 12px;
  background: #f1f5f9;
  font-size: 1.15rem;
  flex-shrink: 0;
  z-index: 1;
}

.timeline-body p {
  margin: 0;
  color: #0f172a;
  font-size: 0.9rem;
  font-weight: 600;
}

.timeline-body span {
  color: #94a3b8;
  font-size: 0.78rem;
}

/* 响应式：窄屏时两栏堆叠 */
@media (max-width: 1080px) {
  .dash-grid {
    grid-template-columns: 1fr;
  }
}

/* ———————————————— 单据 ↔ 库存 / 档案 的跨页关联 ———————————————— */
/* 明细行：商品 | 数量 | 单价 | 删行 */
.form-row.four-col {
  grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr) auto;
  align-items: end;
}

.row-remove-btn {
  align-self: end;
  margin-bottom: 2px;
}

/* 商品选择框下的「现存量 + 查库存」提示 */
.stock-hint {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  margin-top: 4px;
  font-size: 0.78rem;
  color: #64748b;
}

.stock-hint strong {
  color: #0f172a;
  font-weight: 700;
}

.stock-hint strong.num-negative {
  color: #dc2626;
}

/* 从单据跳转过来时的提示条（占满整行） */
.focus-banner {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  padding: 10px 14px;
  border: 1px solid #bfdbfe;
  border-radius: 10px;
  background: #eff6ff;
  color: #1e3a8a;
  font-size: 0.88rem;
}

.focus-banner-tag {
  padding: 2px 8px;
  border-radius: 999px;
  background: #2563eb;
  color: #fff;
  font-size: 0.72rem;
  font-weight: 600;
  white-space: nowrap;
}

.focus-banner-text strong {
  color: #0f172a;
}

/* 档案页被定位到的那一行 */
.focus-row td {
  background: #fef9c3;
  box-shadow: inset 3px 0 0 #eab308;
}

/* 出入库单列表：列多，窄面板下横向滚动而不是把表头/状态挤成竖排 */
.wide-table-wrap {
  overflow-x: auto;
}

.wide-table th,
.wide-table td {
  white-space: nowrap;
}

/* 操作列固定在右侧，横向滚动时也能随时点「打印 / 删除」 */
.wide-table th:last-child,
.wide-table td:last-child {
  position: sticky;
  right: 0;
  background: #ffffff;
  box-shadow: -8px 0 10px -8px rgba(15, 23, 42, 0.15);
}

/* 侧边栏菜单过高时自己滚动，别压住底部「退出登录」 */
.side-nav {
  overflow-y: auto;
  padding-right: 2px;
}

/* 调拨方向：调出仓 → 调入仓，箭头弱化处理，不抢单据号 */
.transfer-arrow {
  color: #94a3b8;
  font-weight: 600;
}

/* 盘点明细：商品列显示快照名（底稿行不允许换商品），单元格内输入框填满 */
.line-product {
  display: inline-block;
  font-weight: 600;
  color: #0f172a;
}

.stocktaking-table input,
.stocktaking-table select {
  width: 100%;
  min-width: 92px;
}

/* 盈亏方向：盘盈（增加）绿、盘亏（减少）红，与财务口径一致 */
.num-profit {
  color: #15803d;
  font-weight: 600;
}

.num-loss {
  color: #b91c1c;
  font-weight: 600;
}

/* 报损 / 报溢 类型切换：两枚方向卡，选中态明确 */
.type-switch {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 14px;
}

.type-switch-btn {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 10px 12px;
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  background: #f8fafc;
  color: #334155;
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: border-color 0.15s ease, background 0.15s ease;
}

.type-switch-btn:hover {
  border-color: #94a3b8;
}

.type-switch-btn.active {
  border-color: #2563eb;
  background: #eff6ff;
  color: #1e3a8a;
  box-shadow: inset 0 0 0 1px #2563eb;
}

.type-switch-sub {
  font-size: 0.75rem;
  font-weight: 400;
  color: #64748b;
}

/* 单据头右侧的按钮组（带出账面库存 / 手工加行） */
.section-actions {
  display: inline-flex;
  gap: 8px;
  align-items: center;
}

/* 盘点明细：盈亏列太窄会把表头挤成两行，给最小宽度并禁止折行 */
.stocktaking-table th:nth-child(4),
.stocktaking-table td:nth-child(4) {
  min-width: 58px;
  white-space: nowrap;
}

/* 明细行内的「现存 N 查库存」不折行，避免商品列被撑成两行 */
.stocktaking-table .stock-hint {
  display: flex;
  white-space: nowrap;
}

/* ── 第 3 批 · 生产类：MRP 运算结果 ─────────────────────────────────── */

/* MRP 汇总指标卡：需求成品 / 物料种类 / 缺料种类 / 缺料金额 */
.mrp-summary {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(118px, 1fr));
  gap: 16px; /* 2026-10-16 全局排版：网格卡片间距统一 16px */
  margin: 12px 0 14px;
}

.mrp-metric {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 10px 12px;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  background: #f8fafc;
}

.mrp-metric span {
  font-size: 12px;   /* 2026-10-16 全局排版：生产看板指标名称 12px */
  color: #6b7280;
}

.mrp-metric strong {
  font-size: 20px;   /* 2026-10-16 全局排版：生产看板指标数字 20px/600 */
  font-weight: 600;
  color: #1e293b;
}

/* 有缺料时指标卡转红，一眼看出要补料 */
.mrp-metric.warn {
  border-color: #fca5a5;
  background: #fef2f2;
}

.mrp-metric.warn strong {
  color: #b91c1c;
}

/* 顶层成品行（产出）与下层物料行区分开 */
.mrp-product-row {
  background: #eff6ff;
}

.mrp-product-row td {
  font-weight: 600;
}

/* ── 报表中心（第 4 批 · 16 张聚合报表）────────────────────────
   16 张报表共用一个渲染器，样式也共用一套：
   左目录（可滚动）+ 右报表体（工具条 + 表格 + 趋势图 + 口径说明）。 */
.report-center {
  display: grid;
  grid-template-columns: 240px minmax(0, 1fr);
  gap: 20px;
  align-items: start;
}

/* 左：报表目录 */
.report-nav {
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.24);
  border-radius: 16px;
  padding: 14px 12px;
  display: flex;
  flex-direction: column;
  gap: 6px;
  position: sticky;
  top: 18px;
  max-height: calc(100vh - 60px);
  overflow-y: auto;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
}

.report-nav-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 2px 4px 10px;
  border-bottom: 1px solid #eef2f7;
  margin-bottom: 4px;
}

.report-nav-head h2 {
  margin: 0;
  font-size: 1.05rem;
}

.report-nav-group {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.report-nav-title {
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #94a3b8;
  padding: 10px 6px 4px;
}

.report-nav-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  width: 100%;
  padding: 8px 10px;
  border: none;
  border-radius: 10px;
  background: transparent;
  color: #334155;
  font-size: 0.9rem;
  text-align: left;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease;
}

.report-nav-item:hover {
  background: #f1f5f9;
}

.report-nav-item.active {
  background: #2563eb;
  color: #ffffff;
  font-weight: 600;
}

.report-nav-item em {
  font-style: normal;
  font-size: 0.68rem;
  opacity: 0.62;
  flex-shrink: 0;
}

/* 右：报表体 */
.report-body {
  min-width: 0;
  margin-top: 0;
}

.report-header {
  align-items: flex-start;
  gap: 14px;
  flex-wrap: wrap;
}

.report-header h2 {
  margin-bottom: 4px;
}

.report-toolbar {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.report-field {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 0.78rem;
  color: #64748b;
}

.report-field input,
.report-select,
.report-search {
  padding: 6px 9px;
  border: 1px solid #cbd5e1;
  border-radius: 9px;
  background: #ffffff;
  color: #0f172a;
  font-size: 0.85rem;
}

.report-search {
  min-width: 168px;
}

.report-range-hint {
  font-size: 0.8rem;
  color: #64748b;
  margin: -8px 0 14px;
}

/* 表格：交叉表可能几十列，必须能横向滚动，首列钉住 */
.report-table-wrap {
  overflow-x: auto;
  margin-top: 4px;
}

.report-table {
  min-width: 100%;
}

.report-table th,
.report-table td {
  white-space: nowrap;
}

.data-table td.num,
.data-table th.num {
  text-align: right;
}

.report-sticky {
  position: sticky;
  left: 0;
  z-index: 1;
  background: #ffffff;
  box-shadow: 1px 0 0 #e2e8f0;
}

.report-table thead .report-sticky {
  background: #ffffff;
}

.report-table tfoot .report-sticky {
  background: #f8fafc;
}

.report-table tfoot td {
  font-weight: 700;
  background: #f8fafc;
  border-top: 2px solid #cbd5e1;
}

.report-name {
  font-weight: 600;
  color: #0f172a;
}

.report-meta {
  font-size: 0.74rem;
  color: #94a3b8;
  font-weight: 400;
}

.report-muted {
  color: #cbd5e1;
}

/* 出入库按国内习惯：入库红、出库绿（与涨红跌绿同一套约定） */
.report-in {
  color: #b91c1c;
  font-weight: 600;
}

.report-out {
  color: #15803d;
  font-weight: 600;
}

/* 各形态的附加区块 */
.report-block {
  margin-top: 22px;
}

.report-overview {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.report-overview .report-block {
  margin-top: 0;
}

.report-overview .report-summary-grid {
  margin-bottom: 4px;
}

.report-chart {
  margin-top: 6px;
}

.report-chart .chart-row span {
  min-width: 66px;
}

.report-notes {
  margin: 22px 0 0;
  padding: 12px 16px 12px 30px;
  background: #f8fafc;
  border: 1px dashed #cbd5e1;
  border-radius: 12px;
  color: #64748b;
  font-size: 0.78rem;
  line-height: 1.7;
}

@media (max-width: 960px) {
  .report-center {
    grid-template-columns: minmax(0, 1fr);
  }

  /* 窄屏下目录变成胶囊墙，别让它把报表本体挤到屏幕外 */
  .report-nav {
    position: static;
    max-height: 232px;
    overflow-y: auto;
  }

  .report-nav-group {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 6px;
  }

  .report-nav-title {
    width: 100%;
    padding-bottom: 0;
  }

  .report-nav-item {
    width: auto;
    border: 1px solid #e2e8f0;
    border-radius: 999px;
    padding: 6px 12px;
    font-size: 0.82rem;
  }

  .report-nav-item em {
    display: none;
  }

  .report-toolbar {
    width: 100%;
  }

  .report-search {
    flex: 1;
    min-width: 120px;
  }
}


/* ============================================================
   系统管理（第 5 批）：组织机构树 / 角色权限树
   ============================================================ */
.system-center {
  display: grid;
  grid-template-columns: minmax(260px, 320px) minmax(0, 1fr);
  gap: 16px;
  align-items: start;
}

.dept-panel {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.dept-tree {
  display: flex;
  flex-direction: column;
  gap: 2px;
  max-height: 320px;
  overflow-y: auto;
  border: 1px solid rgba(148, 163, 184, 0.28);
  border-radius: 10px;
  padding: 6px;
  background: #f8fafc;
}

.dept-node {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6px;
  border-radius: 8px;
  padding-right: 6px;
}

.dept-node:hover {
  background: #eef2ff;
}

.dept-node.active {
  background: #e0e7ff;
}

.dept-node.inactive .dept-name {
  color: #94a3b8;
  text-decoration: line-through;
}

.dept-node-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  background: none;
  border: none;
  padding: 6px 4px;
  cursor: pointer;
  text-align: left;
  color: #1f2937;
  font-size: 0.9rem;
  min-width: 0;
}

.dept-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dept-count {
  flex-shrink: 0;
  min-width: 22px;
  text-align: center;
  font-size: 0.72rem;
  color: #4338ca;
  background: #e0e7ff;
  border-radius: 999px;
  padding: 1px 6px;
}

.dept-actions {
  display: flex;
  gap: 4px;
  flex-shrink: 0;
  opacity: 0;
  transition: opacity 0.15s;
}

.dept-node:hover .dept-actions,
.dept-node.active .dept-actions {
  opacity: 1;
}

.dept-form {
  border-top: 1px dashed rgba(148, 163, 184, 0.45);
  padding-top: 10px;
}

.form-title {
  display: flex;
  align-items: baseline;
  gap: 8px;
  font-weight: 600;
  font-size: 0.9rem;
  color: #334155;
}

.form-subtitle {
  font-weight: 400;
  font-size: 0.76rem;
  color: #64748b;
}

.system-body {
  display: flex;
  flex-direction: column;
  gap: 12px;
  min-width: 0;
}

.system-tabs {
  display: flex;
  gap: 8px;
}

.system-tab {
  border: 1px solid rgba(148, 163, 184, 0.35);
  background: white;
  color: #475569;
  border-radius: 999px;
  padding: 6px 18px;
  cursor: pointer;
  font-size: 0.9rem;
}

.system-tab.active {
  background: #2563eb;
  border-color: #2563eb;
  color: white;
  font-weight: 600;
}

.system-stack {
  display: flex;
  flex-direction: column;
  gap: 14px;
  min-width: 0;
}

/* 注意：这里的 label 都在 .erp-form 内部，而 `.erp-form label` 把 label 设成了
   flex-column。所以权限树用的选择器必须带上 .erp-form 前缀提高优先级，
   否则复选框、文字、计数会被竖着摞成三行。 */
.erp-form label.checkbox-row.inline {
  margin-left: auto;
  font-size: 0.82rem;
  font-weight: 400;
}

.form-actions {
  display: flex;
  gap: 10px;
}

.cell-stack {
  display: flex;
  flex-direction: column;
  line-height: 1.25;
}

.cell-sub {
  color: #64748b;
  font-size: 0.76rem;
  font-weight: 400;
}

.link-btn.danger {
  color: #b91c1c;
}

.status-badge.ok {
  background: rgba(34, 197, 94, 0.14);
  color: #15803d;
}

.status-badge.muted {
  background: #e2e8f0;
  color: #475569;
}

.table-empty {
  text-align: center;
  color: #94a3b8;
  padding: 18px 0;
}

.contract-search select {
  padding: 7px 10px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  font-size: 0.85rem;
  background: white;
  color: #1f2937;
}

.permission-header {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  padding-top: 6px;
  margin-top: 4px;
  border-top: 1px dashed rgba(148, 163, 184, 0.45);
}

.permission-tree {
  display: flex;
  flex-direction: column;
  gap: 10px;
  max-height: 380px;
  overflow-y: auto;
  border: 1px solid rgba(148, 163, 184, 0.28);
  border-radius: 10px;
  padding: 10px 12px;
  background: #f8fafc;
}

.permission-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.erp-form .permission-group-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  font-weight: 600;
  font-size: 0.86rem;
  color: #334155;
}

.erp-form .permission-group-title input {
  width: auto;
  margin: 0;
}

.permission-items {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
  gap: 4px 12px;
  padding-left: 22px;
}

.erp-form .permission-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 6px;
  font-size: 0.84rem;
  font-weight: 400;
  color: #475569;
}

.erp-form .permission-item input {
  width: auto;
  margin: 0;
}

@media (max-width: 960px) {
  .system-center {
    grid-template-columns: minmax(0, 1fr);
  }

  .dept-tree {
    max-height: 220px;
  }

  .permission-tree {
    max-height: 260px;
  }
}

@media (max-width: 760px) {
  /* 触屏没有 hover，操作按钮直接常显 */
  .dept-actions {
    opacity: 1;
  }

  .permission-items {
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
  }

  .system-tabs {
    overflow-x: auto;
  }
}

/* ============================================================
   系统管理（第 5 批第 2 轮）：参数设置 / 数字字典
   ============================================================ */
.param-toolbar {
  display: flex;
  align-items: center;
  gap: 8px;
}

.param-group {
  margin-top: 14px;
}

.param-group-title {
  margin: 0 0 6px;
  font-size: 0.9rem;
  color: #334155;
  padding-bottom: 4px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.28);
}

.param-row {
  display: grid;
  grid-template-columns: minmax(180px, 1.4fr) minmax(160px, 1fr) auto;
  gap: 10px 14px;
  align-items: center;
  padding: 9px 4px;
  border-bottom: 1px dashed rgba(148, 163, 184, 0.22);
}

.param-row:last-child {
  border-bottom: none;
}

.param-meta {
  display: flex;
  flex-direction: column;
  gap: 2px;
  min-width: 0;
}

.param-meta strong {
  font-size: 0.9rem;
  color: #1f2937;
}

.param-control input:not([type='checkbox']) {
  width: 100%;
  padding: 7px 10px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  font-size: 0.86rem;
}

.param-control input:disabled {
  background: #f1f5f9;
  color: #94a3b8;
}

.param-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  justify-content: flex-end;
}

.mono {
  font-family: 'Consolas', 'Menlo', monospace;
}

@media (max-width: 960px) {
  .param-row {
    grid-template-columns: minmax(0, 1fr);
    gap: 6px;
  }

  .param-actions {
    justify-content: flex-start;
  }
}

/* —— 第 5 批第 3 轮：打印模板预览 + 操作日志 —— */
.pdf-preview {
  width: 100%;
  height: 520px;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  background: #f8fafc;
}

/* 日志筛选条：一行放不下时自动折行，窄屏不挤成一条线 */
.log-filters {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
  margin: 12px 0 4px;
}
.log-filters input,
.log-filters select {
  min-width: 0;
  padding: 7px 10px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  background: #ffffff;
  color: #1e293b;
  font-size: 13px;
}
.log-filters input[type='date'] {
  width: 148px;
}
.log-filters input:first-child {
  flex: 1 1 220px;
}

.pager {
  display: flex;
  align-items: center;
  gap: 10px;
  justify-content: flex-end;
  margin-top: 12px;
}

/* 危险操作的"描边"按钮：清空日志这类不可逆动作，
   既要显眼又不能像主按钮那样容易被误点 */
.danger-outline-btn {
  border: 1px solid #fecaca;
  background: #fff1f2;
  color: #b91c1c;
  border-radius: 8px;
  cursor: pointer;
  font-weight: 600;
}
.danger-outline-btn:hover:not(:disabled) {
  background: #ffe4e6;
}
.danger-outline-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.status-badge.warn {
  background: #fef3c7;
  color: #92400e;
}
.status-badge.danger {
  background: #fee2e2;
  color: #b91c1c;
}

@media (max-width: 760px) {
  .pdf-preview {
    height: 380px;
  }
  .log-filters input[type='date'] {
    width: 100%;
  }
}

/* —— 基础资料收尾：期初建账 / 员工档案 —— */
.stat-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin: 12px 0 6px;
}
.stat-row .stat-card {
  padding: 14px 16px;
  gap: 4px;
  box-shadow: none;
  background: #f8fafc;
}
.stat-row .stat-card strong {
  font-size: 1.5rem;
}

/* 期初录入条：一行放不下自动折行，窄屏不会把「加入清单」挤掉 */
.opening-entry {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  align-items: flex-end;
  padding: 14px 16px;
  margin: 8px 0 14px;
  border: 1px dashed #cbd5e1;
  border-radius: 12px;
  background: #f8fafc;
}
.opening-entry label {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 12px;
  color: #475569;
  min-width: 0;
}
.opening-entry select,
.opening-entry input {
  padding: 8px 10px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  background: #ffffff;
  color: #1e293b;
  font-size: 13px;
}
.opening-entry label:nth-child(1) select,
.opening-entry label:nth-child(2) select {
  min-width: 168px;
}
.opening-entry label:nth-child(3) input,
.opening-entry label:nth-child(4) input {
  width: 108px;
}

/* 档案列表上方的筛选条 */
.table-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
  margin: 10px 0 4px;
}
.table-toolbar input,
.table-toolbar select {
  padding: 7px 10px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  background: #ffffff;
  color: #1e293b;
  font-size: 13px;
}
.table-toolbar input {
  flex: 1 1 200px;
}

/* 表格里就地编辑的数字框 */
.cell-input {
  width: 108px;
  padding: 6px 8px;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
  background: #ffffff;
  color: #1e293b;
  font-size: 13px;
  text-align: right;
}

.settings-hint-foot {
  margin-top: 14px;
}

@media (max-width: 960px) {
  .stat-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .opening-entry label:nth-child(1) select,
  .opening-entry label:nth-child(2) select {
    min-width: 0;
    width: 100%;
  }
  .opening-entry label:nth-child(1),
  .opening-entry label:nth-child(2) {
    flex: 1 1 160px;
  }
}

/* —— 组合拆卸：缺料警示条与现存量不足标记 —— */
.assembly-warn {
  margin: 10px 0;
  padding: 10px 14px;
  border: 1px solid #fecaca;
  border-left-width: 4px;
  border-radius: 8px;
  background: #fff1f2;
  color: #b91c1c;
  font-size: 13px;
  line-height: 1.7;
}
.assembly-warn .cell-sub {
  color: #9f1239;
}
/* 用量超过现存量时把数字标红，一眼看出哪一行会欠货 */
.data-table td.num.short {
  color: #b91c1c;
  font-weight: 600;
}
.compact-select,
.compact-input {
  padding: 6px 10px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  background: #ffffff;
  color: #1e293b;
  font-size: 13px;
}
.compact-input {
  width: 150px;
}

/* —— 现金银行 / 日常收支 —— */
.stat-label {
  color: #64748b;
  font-size: 0.85rem;
}
.stat-value {
  font-size: 1.35rem;
  color: #0f172a;
}

/* ---------------------------------------------------------------------------
   第 10 批（动态菜单）：三级导航的缩进与"已隐藏"行
   --------------------------------------------------------------------------- */

/* 二级及更深的菜单项按层级右移，让"分组 → 子分组 → 菜单项"的从属关系在视觉上成立。
   depth 由后端菜单树算出（顶层分组下的菜单项 = 1）。 */
.nav-item.nav-depth-1 {
  padding-left: 36px;
}

.nav-item.nav-depth-2 {
  padding-left: 52px;
  font-size: 13px;
}

/* 二级分组的标题也稍微缩进，避免和顶级分组在同一列上分不清谁是父谁是子 */
.nav-group .nav-group .nav-group-title {
  padding-left: 26px;
  font-size: 13px;
}

/* 菜单管理页里"已隐藏"的行整体压暗，一眼能看出它不会出现在导航里 */
.data-table tbody tr.row-muted td {
  opacity: 0.55;
}

/* ---------------------------------------------------------------------------
   第 11 批：发票管理页暴露出来的两个通用布局缺口
   --------------------------------------------------------------------------- */

/* 宽表格必须自己横向滚动。此前 .table-wrap 根本没有 overflow-x ——
   平时表格列少看不出问题，发票管理页一上 9 列（且抬头列还有副行、操作列有 4 个控件）
   就把**整个文档**撑到 1798px，页面整体出现横向滚动条。 */
.table-wrap {
  overflow-x: auto;
}

/* 面板右上角的操作区允许换行：徽章 + 按钮多了以后不换行会把标题挤出去 */
.param-toolbar {
  flex-wrap: wrap;
}

/* 标题行同理：标题 + 操作区放不下就换行，而不是把文档撑宽 */
.section-header {
  flex-wrap: wrap;
  gap: 10px;
}

/* ---------------------------------------------------------------------------
   第 13 批：发票管理页改造（序号 / 明细子行 / 分页 / 导出菜单 / 三个弹窗）
   --------------------------------------------------------------------------- */

/* 导出下拉菜单的定位锚点。z-index 要压过表格的 sticky 表头，
   否则点开菜单会被表头盖住一半。 */
.export-menu-wrap {
  position: relative;
  display: inline-flex;
  z-index: 30;
}

/* 点空白处关闭菜单：铺一层透明的全屏接收层，比监听 document 上的 click 更可靠
   （不会被菜单按钮自己的冒泡顺序坑到） */
.menu-scrim {
  position: fixed;
  inset: 0;
  z-index: 1;
}

.export-menu {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  z-index: 2;
  min-width: 264px;
  padding: 6px;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  background: #ffffff;
  box-shadow: 0 12px 32px rgba(15, 23, 42, 0.16);
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.export-menu-head {
  padding: 6px 10px 8px;
  font-size: 0.78rem;
  color: #64748b;
  border-bottom: 1px solid #f1f5f9;
  margin-bottom: 4px;
}

.export-menu button {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
  padding: 8px 10px;
  border: none;
  border-radius: 8px;
  background: transparent;
  text-align: left;
  cursor: pointer;
  color: #1e293b;
}

.export-menu button:hover:not(:disabled) {
  background: #f1f5f9;
}

.export-menu button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.export-menu button strong {
  font-size: 0.88rem;
  font-weight: 600;
}

.export-menu button small {
  font-size: 0.74rem;
  color: #64748b;
  line-height: 1.35;
}

/* 顶栏里的「上传发票」——包一层 label 把原生 file input 藏掉，
   不然一个未加样式的 file 控件在按钮排里非常突兀 */
.upload-btn {
  position: relative;
  display: inline-flex;
  align-items: center;
  padding: 6px 14px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  background: #ffffff;
  color: #0f172a;
  font-size: 0.86rem;
  font-weight: 600;
  cursor: pointer;
  height: 44px;
  box-sizing: border-box;
}

.upload-btn:hover {
  background: #f8fafc;
}

.upload-btn input {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
}

/* —— 发票列表 —— */
/* 这一页列特别多（14 列），给一个最小宽度让它自己横向滚动，
   而不是把外面 .main-panel 挤宽（第 11 批踩过：整个文档被撑到 1798px）。
   宽度压到这个值是为了在 1920 屏上能一屏放下，1440 屏上只需小幅滚动。 */
.invoice-table {
  min-width: 1200px;
}

.invoice-table thead th {
  white-space: nowrap;
  position: sticky;
  top: 0;
  z-index: 1;
  background: #f8fafc;
}

.invoice-table th,
.invoice-table td {
  padding: 6px 8px;
}

.invoice-table td.nowrap {
  white-space: nowrap;
}

/* 购买方/销售方名称允许换行（长公司名会让整列特别宽），税号等宽字体方便核对 */
.invoice-table .cell-party {
  min-width: 120px;
  max-width: 170px;
  word-break: break-all;
}

.invoice-table .cell-tax {
  font-size: 0.74rem;
  color: #475569;
  word-break: break-all;
  max-width: 132px;
}

.invoice-table td.strong {
  font-weight: 600;
}

/* 序号列：展开箭头 + 数字。箭头做成接近不可见的方块，只在 hover 时提亮，
   免得一列小三角把整张表的视觉重心拉偏 */
.invoice-serial {
  position: relative;
  /* 不加这句箭头与序号会各自换行，序号竖着排成两行 */
  white-space: nowrap;
}

.caret-btn {
  display: inline-block;
  width: 18px;
  height: 18px;
  margin-right: 4px;
  padding: 0;
  border: none;
  border-radius: 4px;
  background: transparent;
  color: #94a3b8;
  font-size: 0.7rem;
  line-height: 18px;
  text-align: center;
  cursor: pointer;
  vertical-align: middle;
}

.caret-btn:hover:not(:disabled) {
  background: #e2e8f0;
  color: #334155;
}

.caret-btn:disabled {
  opacity: 0.35;
  cursor: default;
}

/* 14 列在 1440px 下必然要横向滚动。"操作"是每行都要点的东西，
   让它**吸附在右边**，滚到哪儿都能点到，不用为了删一张票先滚到最右。
   ⚠️ 吸附列必须给不透明底色，否则表格内容会从它底下透出来。 */
.invoice-table thead th:last-child,
.invoice-table td.row-actions {
  position: sticky;
  right: 0;
  background: #ffffff;
  box-shadow: -10px 0 10px -10px rgba(15, 23, 42, 0.2);
}

.invoice-table thead th:last-child {
  background: #f8fafc;
  z-index: 2;
}

.invoice-table tr.invoice-row-expanded > td.row-actions {
  background: #f1f5f9;
}

.invoice-row-expanded > td {
  background: #f1f5f9;
}

.invoice-no-btn {
  font-size: 0.86rem;
}

/* 明细子行：整行一个单元格，里面再放一张小表 —— 
   明细列与主行列对不齐，硬塞进同一套列里会错位 */
.invoice-detail-row > td {
  padding: 0 !important;
  background: #f8fafc;
}

.invoice-line-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.8rem;
}

.invoice-line-table th,
.invoice-line-table td {
  padding: 6px 10px;
  border-bottom: 1px solid #e2e8f0;
  text-align: left;
  color: #334155;
}

.invoice-line-table th {
  background: #eef2f7;
  font-weight: 600;
  color: #475569;
  white-space: nowrap;
}

.invoice-line-table td.num,
.invoice-line-table th.num {
  text-align: right;
  white-space: nowrap;
}

.invoice-line-table tbody tr:last-child td {
  border-bottom: none;
}

.detail-empty {
  padding: 10px 14px;
  color: #64748b;
  font-size: 0.82rem;
}

/* —— 左下角全选 + 右下角分页 —— */
.invoice-table-footer {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 10px;
}

.select-all-box {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.86rem;
  color: #334155;
  cursor: pointer;
  white-space: nowrap;
}

.footer-hint {
  font-size: 0.8rem;
  color: #64748b;
}

.invoice-table-footer .pager {
  margin-top: 0;
  margin-left: auto;
}

.page-size {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 0.82rem;
  color: #475569;
}

.page-size select {
  padding: 4px 6px;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
  background: #ffffff;
}

.page-indicator {
  font-size: 0.84rem;
  color: #334155;
  min-width: 56px;
  text-align: center;
}

/* —— 原件预览 / 二维码 / 编辑弹窗 —— */
.modal-card.modal-wide {
  width: min(1040px, 94vw);
  max-height: 92vh;
  overflow: auto;
}

.modal-card.modal-narrow {
  width: min(400px, 92vw);
}

.preview-meta {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  padding: 8px 0 10px;
  font-size: 0.82rem;
  color: #64748b;
}

.preview-meta button {
  margin-left: auto;
}

.invoice-preview-img {
  display: block;
  width: 100%;
  max-height: 70vh;
  object-fit: contain;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #f8fafc;
}

.invoice-qr-img {
  display: block;
  width: 260px;
  height: 260px;
  margin: 8px auto 4px;
  image-rendering: pixelated; /* 二维码不要被平滑插值糊掉，糊了扫不动 */
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  background: #ffffff;
}

.settings-hint.center {
  text-align: center;
}

.modal-actions {
  display: flex;
  justify-content: center;
  gap: 10px;
  padding-top: 10px;
}

/* 编辑表单：两列栅格，窄屏塌成一列 */
.invoice-edit-form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px 14px;
  padding-top: 6px;
}

.invoice-edit-form label {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 0.8rem;
  color: #475569;
}

.invoice-edit-form label.span-2 {
  grid-column: 1 / -1;
}

.invoice-edit-form input,
.invoice-edit-form select {
  padding: 7px 9px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
  font-size: 0.86rem;
  color: #0f172a;
  background: #ffffff;
}

.invoice-edit-form label.checkbox-field {
  flex-direction: row;
  align-items: center;
  gap: 8px;
}

.invoice-edit-form label.checkbox-field input {
  width: 16px;
  height: 16px;
  padding: 0;
}

.invoice-edit-form .form-actions {
  display: flex;
  gap: 10px;
  padding-top: 6px;
}

@media (max-width: 760px) {
  .invoice-edit-form {
    grid-template-columns: minmax(0, 1fr);
  }
  .invoice-table-footer .pager {
    margin-left: 0;
  }
}

/* 表单里的"填写依据"提示文字：跟 .settings-hint 一样是给人读的，但不占整行 */
.field-hint {
  display: block;
  padding: 7px 0;
  font-size: 0.76rem;
  line-height: 1.5;
  color: #64748b;
}

/* 商品列表：税率与操作列不允许被挤到换行。
   表格是 auto 布局，新加的「税率」列（内容是"未设置"徽章）会被自动压到
   只有两三个字宽，徽章就竖排成"未/设/置" —— 给一个最小宽度即可。 */
.product-table th:nth-child(5),
.product-table td:nth-child(5) {
  min-width: 88px;
  white-space: nowrap;
}

.product-table th:nth-child(6),
.product-table td:nth-child(6) {
  min-width: 72px;
  white-space: nowrap;
}

/* ---------------------------------------------------------------------------
   第 1 期（多账套）：顶栏的当前公司名与账套切换
   --------------------------------------------------------------------------- */

.topbar-right {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.company-switch {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

/* 当前账套：做成一个"状态徽标"而不是按钮 —— 它是只读信息，
   真正的操作入口是旁边那个下拉，两个都做成可点的会让人分不清点哪个 */
.company-chip {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  height: 44px;
  padding: 0 14px;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  background: #f8fafc;
  color: #0f172a;
  font-size: 0.88rem;
  font-weight: 600;
  white-space: nowrap;
  box-sizing: border-box;
}

.company-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #16a34a;
  flex: none;
}

.company-select {
  height: 44px;
  padding: 0 10px;
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  background: #ffffff;
  color: #0f172a;
  font-size: 0.86rem;
  cursor: pointer;
  box-sizing: border-box;
}

.company-select:disabled {
  opacity: 0.6;
  cursor: wait;
}

@media (max-width: 760px) {
  /* 手机端顶栏本来就窄，账套名先让位给操作按钮，避免右侧挤成两行 */
  .company-chip {
    display: none;
  }
}

/* —— 商品档案：树形类别 + 搜索栏（对齐浩技云「商品管理」）—— */
.category-tree {
  display: flex;
  flex-direction: column;
  gap: 2px;
  max-height: 260px;
  overflow-y: auto;
  margin-bottom: 8px;
}

.cat-node {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 5px 6px;
  border-radius: 6px;
  font-size: 0.92rem;
}
.cat-node:hover {
  background: #f1f5f9;
}
.cat-caret {
  width: 14px;
  color: #94a3b8;
  font-size: 0.8rem;
  flex-shrink: 0;
}
.cat-caret.leaf {
  color: #cbd5e1;
}
.cat-name {
  flex: 1;
  color: #334155;
}
.cat-actions {
  display: none;
  gap: 2px;
  flex-shrink: 0;
}
.cat-node:hover .cat-actions {
  display: inline-flex;
}

.toolbar-row {
  margin-bottom: 12px;
}
.search-input {
  width: 100%;
  padding: 9px 12px;
  border: 1px solid #e2e8f0;
  border-radius: 8px;
  font-size: 0.92rem;
  box-sizing: border-box;
}
.search-input:focus {
  outline: none;
  border-color: #2563eb;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
}

.nowrap {
  white-space: nowrap;
}

/* —— 新增/编辑表单弹窗：统一内边距 + 操作按钮（对齐浩技云「点创建弹窗」观感）—— */
.modal-card .erp-form {
  padding: 18px 22px;
}
.modal-card .erp-form .form-actions {
  display: flex;
  gap: 10px;
  justify-content: flex-end;
  padding-top: 4px;
}
.modal-card .erp-form textarea {
  min-height: 72px;
}

/* ═══════════════════════════════════════════════════════════════════════
   左侧树状导航 · 配色主题（多风格切换）
   ───────────────────────────────────────────────────────────────────────
   切换方式：根容器 `.app-shell` 上的 `data-nav-theme` 属性。
   **不写属性 = 默认「深空蓝」**，与改造前完全一致（老用户观感零变化）。
   全部走 CSS 变量，所以新增一套风格只需再加一个 [data-nav-theme=...] 块，
   不用碰任何组件代码。**只作用于左侧导航**，顶栏与主内容区不动。

   为什么用变量 + 属性而不是给每个主题写一遍选择器：主题之间只差「颜色」，
   结构完全一样。写两遍选择器迟早会漂移（改一处忘一处），变量只有一个来源。
   ═══════════════════════════════════════════════════════════════════════ */
.app-shell {
  /* 默认 · 深空蓝（原样式） */
  --nav-bg: #111827;
  --nav-border: transparent;
  --nav-brand-fg: #f1f5f9;
  --nav-brand-mark: linear-gradient(135deg, #2563eb, #4f46e5);
  --nav-group-fg: #7c8ba1;
  --nav-group-fg-hover: #cbd5e1;
  --nav-group-fg-active: #93c5fd;
  --nav-item-fg: #cbd5e1;
  --nav-item-fg-hover: #f8fafc;
  --nav-dot: #475569;
  --nav-item-hover-bg: rgba(255, 255, 255, 0.06);
  --nav-active-bg: linear-gradient(90deg, rgba(37, 99, 235, 0.92), rgba(79, 70, 229, 0.72));
  --nav-active-fg: #ffffff;
  --nav-active-dot: #ffffff;
  --nav-active-shadow: 0 6px 16px -8px rgba(37, 99, 235, 0.95);
  --nav-logout-border: rgba(148, 163, 184, 0.4);
  --nav-logout-bg: rgba(15, 23, 42, 0.18);
  --nav-logout-fg: #ffffff;
}

/* ① 石墨黑 · 极简冷灰 */
.app-shell[data-nav-theme='graphite'] {
  --nav-bg: #0b0b0d;
  --nav-brand-mark: linear-gradient(135deg, #52525b, #27272a);
  --nav-group-fg: #71717a;
  --nav-group-fg-hover: #d4d4d8;
  --nav-group-fg-active: #e4e4e7;
  --nav-item-fg: #d4d4d8;
  --nav-dot: #52525b;
  --nav-item-hover-bg: rgba(255, 255, 255, 0.07);
  --nav-active-bg: linear-gradient(90deg, #3f3f46, #18181b);
  --nav-active-shadow: 0 6px 16px -8px rgba(0, 0, 0, 0.85);
}

/* ② 靛蓝 · 偏紫夜空 */
.app-shell[data-nav-theme='indigo'] {
  --nav-bg: #1e1b4b;
  --nav-brand-mark: linear-gradient(135deg, #6366f1, #8b5cf6);
  --nav-group-fg: #a5a3d4;
  --nav-group-fg-hover: #e0e7ff;
  --nav-group-fg-active: #c7d2fe;
  --nav-item-fg: #ded9fb;
  --nav-dot: #6366f1;
  --nav-item-hover-bg: rgba(255, 255, 255, 0.08);
  --nav-active-bg: linear-gradient(90deg, #6366f1, #8b5cf6);
  --nav-active-shadow: 0 6px 16px -8px rgba(99, 102, 241, 0.95);
  --nav-logout-border: rgba(199, 210, 254, 0.35);
  --nav-logout-bg: rgba(15, 23, 42, 0.25);
}

/* ③ 青松绿 · 呼应首页蓝绿主色 */
.app-shell[data-nav-theme='pine'] {
  --nav-bg: #052e2b;
  --nav-brand-mark: linear-gradient(135deg, #0d9488, #059669);
  --nav-group-fg: #6ea8a0;
  --nav-group-fg-hover: #ccfbf1;
  --nav-group-fg-active: #5eead4;
  --nav-item-fg: #c7ece7;
  --nav-dot: #14b8a6;
  --nav-item-hover-bg: rgba(255, 255, 255, 0.07);
  --nav-active-bg: linear-gradient(90deg, #0d9488, #059669);
  --nav-active-shadow: 0 6px 16px -8px rgba(13, 148, 136, 0.95);
  --nav-logout-border: rgba(94, 234, 212, 0.35);
  --nav-logout-bg: rgba(2, 44, 34, 0.4);
}

/* ④ 勃艮第红 · 商务暗红 */
.app-shell[data-nav-theme='burgundy'] {
  --nav-bg: #2a1215;
  --nav-brand-mark: linear-gradient(135deg, #be123c, #7f1d1d);
  --nav-group-fg: #a8828a;
  --nav-group-fg-hover: #fecdd3;
  --nav-group-fg-active: #fda4af;
  --nav-item-fg: #ecd6da;
  --nav-dot: #9f1239;
  --nav-item-hover-bg: rgba(255, 255, 255, 0.07);
  --nav-active-bg: linear-gradient(90deg, #be123c, #9f1239);
  --nav-active-shadow: 0 6px 16px -8px rgba(190, 18, 60, 0.95);
  --nav-logout-border: rgba(253, 164, 175, 0.32);
  --nav-logout-bg: rgba(60, 10, 20, 0.45);
}

/* ⑤ 珍珠白 · 浅色侧边栏（白天/投屏更清爽） */
.app-shell[data-nav-theme='light'] {
  --nav-bg: #ffffff;
  --nav-border: #e2e8f0;
  --nav-brand-fg: #0f172a;
  --nav-brand-mark: linear-gradient(135deg, #2563eb, #0d9488);
  --nav-group-fg: #94a3b8;
  --nav-group-fg-hover: #475569;
  --nav-group-fg-active: #2563eb;
  --nav-item-fg: #475569;
  --nav-item-fg-hover: #0f172a;
  --nav-dot: #cbd5e1;
  --nav-item-hover-bg: #f1f5f9;
  --nav-active-bg: linear-gradient(90deg, #2563eb, #0d9488);
  --nav-active-shadow: 0 6px 16px -10px rgba(37, 99, 235, 0.55);
  --nav-logout-border: #e2e8f0;
  --nav-logout-bg: #f8fafc;
  --nav-logout-fg: #334155;
}

/* 把变量接到实际的导航元素上（`.app-shell` 前缀是为了稳定压过原规则） */
.app-shell .sidebar {
  background: var(--nav-bg);
  border-right: 1px solid var(--nav-border);
}
.app-shell .brand-text { color: var(--nav-brand-fg); }
.app-shell .brand-mark { background: var(--nav-brand-mark); }
.app-shell .nav-group-title { color: var(--nav-group-fg); }
.app-shell .nav-group-title:hover { color: var(--nav-group-fg-hover); }
.app-shell .nav-group.has-active .nav-group-title { color: var(--nav-group-fg-active); }
.app-shell .nav-item { color: var(--nav-item-fg); }
.app-shell .nav-item::before { background: var(--nav-dot); }
.app-shell .nav-item:hover {
  background: var(--nav-item-hover-bg);
  color: var(--nav-item-fg-hover);
}
.app-shell .nav-item.active {
  background: var(--nav-active-bg);
  color: var(--nav-active-fg);
  box-shadow: var(--nav-active-shadow);
}
.app-shell .nav-item.active::before { background: var(--nav-active-dot); }
.app-shell .logout-btn {
  border-color: var(--nav-logout-border);
  background: var(--nav-logout-bg);
  color: var(--nav-logout-fg);
}

/* ── 主题切换器（侧边栏底部一排小圆点）────────────────────────────── */
.nav-theme-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 8px 6px 2px;
}
.nav-theme-picker-label {
  font-size: 0.68rem;
  letter-spacing: 0.06em;
  color: var(--nav-group-fg);
  white-space: nowrap;
}
.nav-theme-dots {
  display: flex;
  gap: 7px;
}
.nav-theme-dot {
  width: 18px;
  height: 18px;
  padding: 0;
  border-radius: 50%;
  border: 2px solid transparent;
  cursor: pointer;
  transition: transform 0.15s ease, border-color 0.15s ease;
}
.nav-theme-dot:hover { transform: scale(1.12); }
.nav-theme-dot.selected {
  border-color: var(--nav-item-fg-hover);
  box-shadow: 0 0 0 2px var(--nav-bg);
}


/* ---------------------------------------------------------------------------
   商品档案 · 左侧类别树交互（2026-10-16）
   点整行 = 按该类别（含其全部子孙）过滤右侧列表；点小三角 = 折叠/展开。
   逻辑在 src/lib/productCategory.js，这里只管长相。
   --------------------------------------------------------------------------- */

/* 树变高了：原来 max-height:260px 只够看 8 行，实测库里光顶级类别就有 39 个 */
.category-tree {
  max-height: 420px;
}

/* 顶端固定的两行（全部商品 / 未分类）与下面的类别树之间来一条分隔线 */
.cat-root-group {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding-bottom: 4px;
  margin-bottom: 4px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.28);
}

.cat-node {
  cursor: pointer;
  user-select: none;
}

/* 选中的类别：整行底色 + 加粗，角标反白，一眼能看出右侧列表在被谁过滤 */
.cat-node.is-active {
  background: #e0edff;
}
.cat-node.is-active .cat-name {
  color: #1d4ed8;
  font-weight: 600;
}
.cat-node.is-active .cat-count {
  background: #1d4ed8;
  color: #fff;
}

/* 小三角：手写 SVG，展开时朝下、折叠时转 -90° 朝右 */
.cat-caret {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  border-radius: 4px;
  flex-shrink: 0;
}
.cat-caret svg {
  transition: transform 0.15s ease;
}
.cat-caret:hover {
  background: rgba(148, 163, 184, 0.3);
}
.cat-caret.is-collapsed svg {
  transform: rotate(-90deg);
}
.cat-caret.leaf {
  cursor: default;
  color: #cbd5e1;
}
.cat-caret.leaf:hover {
  background: transparent;
}

/* 类别右侧的商品数角标 */
.cat-count {
  flex-shrink: 0;
  min-width: 22px;
  padding: 0 5px;
  border-radius: 9px;
  background: rgba(148, 163, 184, 0.22);
  color: #475569;
  font-size: 0.72rem;
  line-height: 16px;
  text-align: center;
}

/* ══ 商品弹窗 · 图片本地上传预览 ═══════════════════════════════════════════
   商品新增/编辑弹窗（src/components/product-edit/ProductEditModal.jsx）里的
   图片字段：预览框 + 选择/更换/移除 + 拖拽接收区。
   类名前缀 .pimg-，与本文件既有约定一致（.cat- 归类别树、.erpstock- 归库存预警、
   .erpdash- 归经营看板），四套互不干扰。 */

/* 编辑弹窗用的是两列网格（.invoice-edit-form），图片块要独占整行 */
.invoice-edit-form .pimg-block {
  grid-column: 1 / -1;
}

/* 「商品图片」这个标题要跟 .erp-form label / .invoice-edit-form label > span 视觉一致 */
.pimg-block-title {
  display: block;
  color: #374151;
  font-weight: 500;
  font-size: 14px;
}

.pimg {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  flex-wrap: wrap;
}

/* 预览框固定 96×96：否则"有图/没图"会让弹窗高度来回抖 */
.pimg-preview {
  position: relative;
  width: 96px;
  height: 96px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px dashed #cbd5e1;
  border-radius: 10px;
  background: #f8fafc;
  overflow: hidden;
  transition: border-color 0.15s ease, background 0.15s ease;
}

.pimg-preview.is-dragging {
  border-color: #2563eb;
  background: #e0edff;
}

/* object-fit 用 contain 不用 cover：商品图多是白底方图，cover 会把主体裁掉 */
.pimg-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.pimg-empty {
  color: #94a3b8;
  font-size: 0.74rem;
}

/* 上传中的遮罩：本地预览已经出来了，这里只是告诉用户"服务器那份还在传" */
.pimg-uploading {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.55);
  color: #ffffff;
  font-size: 0.74rem;
}

.pimg-side {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
  min-width: 150px;
}

.pimg-hint {
  color: #94a3b8;
  font-size: 0.72rem;
  line-height: 1.5;
}

/* 真正的文件选择框：视觉隐藏但留在可访问树里。
   不用 display:none —— 那会被读屏软件整个忽略掉，
   而且部分浏览器上"以编程方式 click 一个 display:none 的 input"行为并不一致。 */
.pimg-file {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
  border: 0;
}
